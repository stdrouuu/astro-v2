---
import SectionCat from '../SectionCat.astro';

import ProjectCard from '../ProjectCard.astro';
import { projects } from '../../data/projects';
---

<section id="projects" class="space-y-4 sm:space-y-6" aria-labelledby="selected-projects-title">
  <div>
    <h2 id="selected-projects-title" class="pr-[5.25rem] sm:pr-0 max-[380px]:!text-[1.375rem] relative font-pixel text-3xl sm:text-3xl md:text-4xl flex items-center gap-2 border-y border-neutral-300/80 dark:border-neutral-800 py-3 sm:py-4 my-4 sm:my-6">
      <span class="text-neutral-400">##</span>
      <span>Projects</span>
      <SectionCat activity="coding" />
    </h2>
    <p class="text-neutral-600 dark:text-neutral-400 text-sm sm:text-base leading-relaxed">
    A selection of client work, independent web tools, and projects built with classmates.
    </p>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-7 gap-y-10 sm:gap-x-8 sm:gap-y-12">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</section>

<script>
  const touchOnly = window.matchMedia('(any-hover: none) and (pointer: coarse)');
  const cards = [...document.querySelectorAll<HTMLElement>('#projects .project-card')];
  let activeCard: HTMLElement | undefined;
  let frame = 0;

  function updateActiveCard() {
    frame = 0;
    let nextCard: HTMLElement | undefined;

    if (touchOnly.matches) {
      const viewportCenter = window.innerHeight / 2;
      let closestDistance = viewportCenter * 0.65;

      for (const [index, card] of cards.entries()) {
        const { top, bottom, height } = card.getBoundingClientRect();
        if (height === 0 || bottom <= 0 || top >= window.innerHeight) continue;

        // Give side-by-side cards distinct trigger points in the same row.
        const followsCardInRow = cards[index - 1]?.offsetTop === card.offsetTop;
        const precedesCardInRow = cards[index + 1]?.offsetTop === card.offsetTop;
        const anchor = followsCardInRow ? 0.7 : precedesCardInRow ? 0.3 : 0.5;
        const distance = Math.abs(top + height * anchor - viewportCenter);

        if (distance < closestDistance) {
          closestDistance = distance;
          nextCard = card;
        }
      }
    }

    if (activeCard === nextCard) return;
    activeCard?.removeAttribute('data-scroll-active');
    nextCard?.setAttribute('data-scroll-active', '');
    activeCard = nextCard;
  }

  function scheduleUpdate() {
    if (frame === 0) frame = window.requestAnimationFrame(updateActiveCard);
  }

  function updateInputMode() {
    if (touchOnly.matches) {
      window.addEventListener('scroll', scheduleUpdate, { passive: true });
      window.addEventListener('resize', scheduleUpdate);
    } else {
      window.removeEventListener('scroll', scheduleUpdate);
      window.removeEventListener('resize', scheduleUpdate);
    }
    scheduleUpdate();
  }

  touchOnly.addEventListener('change', updateInputMode);
  updateInputMode();
</script>
