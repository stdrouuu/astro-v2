---
interface FeaturedProject {
  title: string;
  desc?: string;
  date: string;
  link?: string;
  icon?: string;
  imgClass?: string;
  iconClass?: string;
}

interface BentoProject {
  title: string;
  category: string;
  link?: string;
  image?: string;
  imgClass?: string;
  stacks?: string[];
}

const featuredList: FeaturedProject[] = [
  {
    title: 'BisaChord',
    desc: 'Lorem ipsum dolor sit amet, eiusmod irure proident in consequat. Voluptate excepteur',
    date: 'Present',
    icon: '/img/bisachord.webp',
    imgClass: 'scale-[3.0]',
  },
  {
    title: 'Memein',
    desc: 'Lorem ipsum dolor sit amet, eiusmod irure proident in consequat. Voluptate excepteur',
    date: 'Present',
    icon: '/img/memein.webp',
    imgClass: 'scale-[2.0]',
  },
  {
    title: 'Stockinfo',
    desc: 'Lorem ipsum dolor sit amet, eiusmod irure proident in consequat. Voluptate excepteur',
    date: 'Jun 2026',
    icon: '/img/stockinfo.webp',
    imgClass: 'scale-[1.8]',
  },
  {
    title: 'Trigg',
    desc: 'Lorem ipsum dolor sit amet, eiusmod irure proident in consequat. Voluptate excepteur',
    date: 'Mar 2026',
    icon: '/img/trigg.webp',
    imgClass: 'scale-[2.8]',
  },
];

const bentoProjects: BentoProject[] = [
  {
    title: 'BisaChord',
    category: 'Progressive Web App (PWA) to convert musical notation',
    link: '',
    image: '/img/bisachord.webp',
    imgClass: 'scale-[1.2]',
    stacks: ['React', 'TypeScript', 'Tailwind CSS', 'PWA'],
  },
  {
    title: 'Memein',
    category: 'Meme Editor with Customization and Meme templates',
    link: '',
    image: '/img/memein.webp',
    imgClass: 'scale-[1.5]',
    stacks: ['React', 'TypeScript', 'Tailwind CSS', 'Framer Motion'],
  },
  {
    title: 'Stockinfo',
    category: 'Buildings Material Store & Warehouse Inventory Management System',
    link: '',
    image: '/img/stockinfo.webp',
    imgClass: 'scale-[1.2]',
    stacks: ['Laravel', 'PHP', 'MySQL', 'Tailwind CSS'],
  },
  {
    title: 'Trigg',
    category: 'Full-Stack Game Store with Stripe Payment Gateway',
    link: '',
    image: '/img/trigg.webp',
    imgClass: 'scale-[1.1]',
    stacks: ['Next.js', 'TypeScript', 'PostgreSQL', 'Prisma'],
  },
];
---

<section id="projects" class="space-y-6 sm:space-y-8 pt-2 sm:pt-4">
  <h2 class="font-pixel text-3xl sm:text-3xl md:text-4xl flex items-center gap-2 border-y border-neutral-300/80 dark:border-neutral-800 py-3 sm:py-4 my-4 sm:my-6">
    <span class="text-neutral-400">##</span>
    <span>Projects</span>
  </h2>

  {/* 1. Featured List Projects */}
  <div class="space-y-1">
    {featuredList.map((item) => {
      const isLink = Boolean(item.link);
      const Tag = isLink ? 'a' : 'div';
      return (
        <Tag
          href={item.link || undefined}
          target={item.link && item.link.startsWith('http') ? '_blank' : undefined}
          rel={item.link && item.link.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="flex items-center justify-between gap-3 sm:gap-4 py-2 px-2.5 -mx-2.5 rounded-lg cursor-default"
        >
          <div class="flex items-center gap-3.5 min-w-0">
            {/* Logo */}
            <div class="w-11 h-11 sm:w-12 sm:h-12 flex-shrink-0 flex items-center justify-center rounded-md overflow-hidden">
              {item.icon ? (
                <img
                  src={item.icon}
                  alt={item.title}
                  class={`w-full h-full object-cover rounded-md ${item.imgClass || ''}`}
                  loading="lazy"
                />
              ) : (
                <span class="font-mono text-[16px] font-semibold text-neutral-600 dark:text-neutral-300 select-none">
                  {item.title.substring(0, 2).toUpperCase()}
                </span>
              )}
            </div>

            {/* Title & Description */}
            <div class="min-w-0">
              <div class="flex items-center gap-1.5">
                <h3 class="font-medium text-neutral-900 dark:text-neutral-100 text-[17px] sm:text-[18px] leading-snug truncate">
                  {item.title}
                </h3>
                {isLink && (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-4 h-4 text-neutral-400 flex-shrink-0"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                  </svg>
                )}
              </div>
              {item.desc && (
                <p class="text-[15px] sm:text-[16px] text-[#A3A39F] truncate leading-relaxed mt-0.5">
                  {item.desc}
                </p>
              )}
            </div>
          </div>

          {/* Date */}
          <span class="font-mono text-[15px] sm:text-[16px] text-neutral-500 dark:text-neutral-400 flex-shrink-0 ml-2 sm:ml-4 text-right">
            {item.date}
          </span>
        </Tag>
      );
    })}
  </div>

  {/* 2. Bento Grid Cards (4 Projects) */}
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-7 pt-2">
    {bentoProjects.map((project) => {
      const Tag = project.link ? 'a' : 'div';
      return (
        <Tag
          href={project.link || undefined}
          target={project.link && project.link.startsWith('http') ? '_blank' : undefined}
          rel={project.link && project.link.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="block space-y-3 sm:space-y-3.5 focus:outline-none"
        >
          {/* Card / Image Box - rectangular with subtle rounded corners */}
          <div class="w-full aspect-[4/3] rounded-md bg-neutral-200/50 dark:bg-neutral-800/60 border border-neutral-300/80 dark:border-neutral-700/60 overflow-hidden relative flex items-center justify-center">
            {project.image ? (
              <img
                src={project.image}
                alt={project.title}
                class={`w-full h-full object-cover object-center ${project.imgClass || ''}`}
                loading="lazy"
              />
            ) : (
              <div class="flex flex-col items-center justify-center gap-1.5 text-neutral-400 dark:text-neutral-500 select-none">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-7 h-7 opacity-40"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"
                  />
                </svg>
              </div>
            )}
          </div>

          {/* Project Details */}
          <div class="space-y-2.5">
            <div>
              <h3 class="font-medium text-neutral-900 dark:text-neutral-100 text-[17px] sm:text-[18px] md:text-[19px] leading-snug">
                {project.title}
              </h3>
              <p class="text-[14.5px] sm:text-[16px] text-[#A3A39F] leading-snug mt-1">
                {project.category}
              </p>
            </div>

            {/* Tech Stack Pills (Text Only) */}
            {project.stacks && project.stacks.length > 0 && (
              <div class="flex flex-wrap items-center gap-1.5 pt-0.5">
                {project.stacks.map((stack) => (
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-[12px] sm:text-[13px] font-sans font-medium bg-neutral-200/60 dark:bg-neutral-800/70 border border-neutral-300/70 dark:border-neutral-700/60 text-neutral-700 dark:text-neutral-300 select-none">
                    {stack}
                  </span>
                ))}
              </div>
            )}
          </div>
        </Tag>
      );
    })}
  </div>
</section>


