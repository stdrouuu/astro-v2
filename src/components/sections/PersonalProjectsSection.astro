---
import ProjectCard from '../ProjectCard.astro';
import { projects } from '../../data/projects';
---

<section id="projects" class="space-y-5 sm:space-y-6" aria-labelledby="selected-projects-title">
  <div class="flex flex-wrap items-center justify-between gap-x-3 border-y border-neutral-300/80 dark:border-neutral-800">
    <h2 id="selected-projects-title" class="readme-heading border-0"><span aria-hidden="true">##</span> Projects</h2>
    <a href="/projects" class="quiet-link">All projects <span aria-hidden="true">↗</span></a>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-7">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</section>
