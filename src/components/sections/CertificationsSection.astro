---
interface FeaturedCertification {
  title: string;
  issuer?: string;
  date: string;
  link?: string;
  icon?: string;
}

interface Hackathon {
  title: string;
  issuer: string;
  date: string;
  description?: string;
  icon: string;
  link?: string;
}

const hackathons: Hackathon[] = [
  {
    title: 'Sea × OpenAI Regional Codex Hackathon',
    issuer: 'Indonesia',
    date: 'Oct 2026',
    icon: '/img/sea-logo.webp',
    link: 'https://www.linkedin.com/in/brandon-jeremiah-sutedja/',
  },
  {
    title: 'STACK GDGoC ITB Hackathon 2026',
    issuer: 'Google Developer Group on Campus',
    date: 'Oct 2026',
    description: 'Qualified to Semifinal from 3,000+ registered teams and 9,000+ registered members across Indonesia.',
    icon: '/img/google-developers.webp',
  },
];

const featuredCertifications: FeaturedCertification[] = [
  {
    title: 'Oracle Database Programming with PL/SQL',
    issuer: 'Oracle',
    date: 'Jun 2026',
    icon: '/img/oracle.webp',
  },
  {
    title: 'Oracle Database Foundations',
    issuer: 'Oracle',
    date: 'Jun 2026',
    icon: '/img/oracle.webp',
  },
  {
    title: 'Postman API Fundamentals Student Expert',
    issuer: 'Postman',
    date: '',
    icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/postman/postman-original.svg',
  },
  {
    title: 'Back-End Development with JavaScript',
    link: 'https://www.dicoding.com/certificates/QLZ96K4Y7Z5D',
    issuer: 'Dicoding Indonesia',
    date: 'Aug 2025',
    icon: '/img/dicoding.webp',
  },
  {
    title: 'Essentials of Web Programming',
    link: 'https://www.dicoding.com/certificates/98XWEWELJXM3',
    issuer: 'Dicoding Indonesia',
    date: 'Dec 2024',
    icon: '/img/dicoding.webp',
  },
  {
    title: 'REFO x Google Cybscure Student Leaders 2023',
    issuer: 'REFO x Google',
    date: '2023',
    icon: '/img/google.webp',
  },
];
---

<section id="certifications" class="space-y-6" aria-labelledby="credentials-title">
  <div id="hackathons" class="space-y-4">
    <ul class="space-y-3">
      {hackathons.map(({ title, issuer, date, description, icon, link }) => (
        <li class="flex items-center gap-3.5 rounded-md border border-neutral-300/80 bg-neutral-200/40 px-3.5 py-3 dark:border-neutral-700/60 dark:bg-neutral-800/50">
          <img class="h-10 w-10 flex-shrink-0 rounded-md bg-white object-contain p-1" src={icon} width="40" height="40" alt="" loading="lazy" decoding="async" />
          <div class="min-w-0 flex-1 space-y-0.5">
            <p class="font-pixel text-sm text-[#214ECF] dark:text-[#89A4FF]">Recognition</p>
            <h3 class="font-medium leading-snug text-neutral-900">{title}</h3>
            <p class="text-sm text-neutral-600">{issuer} · {date}</p>
            {description && <p class="pt-1 text-sm leading-snug text-neutral-600">{description}</p>}
          </div>
          {link && <a class="quiet-link shrink-0 self-center" href={link} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>}
        </li>
      ))}
    </ul>
  </div>
  <h2 id="credentials-title" class="readme-heading"><span aria-hidden="true">##</span> Certifications</h2>
  <ul class="space-y-3 sm:space-y-3.5">
    {featuredCertifications.map(({ title, issuer, date, icon, link }) => (
      <li class="flex items-start gap-3 sm:gap-3.5 py-1">
        {icon && <img class="w-10 h-10 sm:w-11 sm:h-11 flex-shrink-0 rounded-md object-contain mt-0.5" src={icon} width="44" height="44" alt="" loading="lazy" decoding="async" />}
        <div class="min-w-0 space-y-0.5">
          <h3 class="font-medium leading-snug text-neutral-900">{link ? <a class="hover:underline underline-offset-4" href={link} target="_blank" rel="noopener noreferrer">{title} <span aria-hidden="true">↗</span></a> : title}</h3>
          <p class="text-[15px] text-neutral-600 leading-snug">{issuer}</p>
          {date && <p class="text-[15px] text-neutral-600 leading-snug">Issued {date}</p>}
        </div>
      </li>
    ))}
  </ul>
</section>
