---
interface FeaturedCertification {
  title: string;
  issuer?: string;
  date: string;
  link?: string;
  icon?: string;
}

const featuredCertifications: FeaturedCertification[] = [
  {
    title: 'Oracle Database Programming with PLSQL – English',
    issuer: 'Oracle',
    date: 'Jun 2026',
    icon: '/img/oracle.webp',
    link: '#',
  },
  {
    title: 'Oracle Database Foundations – English',
    issuer: 'Oracle',
    date: 'Jun 2026',
    icon: '/img/oracle.webp',
    link: '#',
  },
  {
    title: 'Postman API Fundamentals Student Expert',
    issuer: 'Postman',
    date: 'Present',
    icon: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/postman/postman-original.svg',
    link: '#',
  },
  {
    title: 'Back-End Development with JavaScript (Node.js) using AWS and Postman API',
    issuer: 'Dicoding Indonesia',
    date: 'Aug 2025',
    icon: '/img/dicoding.webp',
    link: '#',
  },
  {
    title: 'Essentials of Web Programming',
    issuer: 'Dicoding Indonesia',
    date: 'Dec 2024',
    icon: '/img/dicoding.webp',
    link: '#',
  },
  {
    title: 'REFO x Google Cybscure Student Leaders 2023',
    issuer: 'REFO x Google',
    date: '2023',
    icon: '/img/google.webp',
    link: '#',
  },
];
---

<section id="certifications" class="space-y-6 pt-2 sm:pt-4">
  <h2 class="font-pixel text-xl sm:text-2xl md:text-3xl flex items-center gap-2 border-y border-neutral-300/80 dark:border-neutral-800 py-3 sm:py-4 my-4 sm:my-6">
    <span class="text-neutral-400">##</span>
    <span>certifications</span>
  </h2>

  {/* Certifications List */}
  <div class="space-y-4 sm:space-y-5">
    {featuredCertifications.map((item) => {
      const isExternal = item.link && item.link.startsWith('http');
      const formattedDate = item.date.toLowerCase().startsWith('issued')
        ? item.date
        : `Issued ${item.date}`;

      return (
        <a
          href={item.link || '#'}
          target={isExternal ? '_blank' : undefined}
          rel={isExternal ? 'noopener noreferrer' : undefined}
          class="flex items-start gap-3 sm:gap-3.5 py-1 px-1.5 -mx-1.5 rounded-lg group cursor-pointer transition-all hover:bg-neutral-100/70 dark:hover:bg-neutral-800/40"
        >
          {/* Logo / Icon */}
          <div class="w-8 h-8 sm:w-9 sm:h-9 flex-shrink-0 flex items-center justify-center rounded-md overflow-hidden mt-0.5">
            {item.icon ? (
              <img
                src={item.icon}
                alt={item.title}
                class="w-full h-full object-cover rounded-md group-hover:scale-105 transition-transform duration-200"
                loading="lazy"
              />
            ) : (
              <span class="font-mono text-xs font-semibold text-neutral-600 dark:text-neutral-300 select-none">
                {item.title.substring(0, 2).toUpperCase()}
              </span>
            )}
          </div>

          {/* Details */}
          <div class="min-w-0 flex-1 space-y-0.5">
            <div class="flex items-center gap-1.5">
              <h3 class="font-medium text-neutral-900 dark:text-neutral-100 text-[14.5px] sm:text-[15.5px] leading-tight group-hover:text-black dark:group-hover:text-white transition-colors">
                {item.title}
              </h3>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-3.5 h-3.5 text-neutral-400 dark:text-neutral-400 group-hover:text-neutral-700 dark:group-hover:text-neutral-200 transition-colors flex-shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </div>
            {item.issuer && (
              <p class="text-xs sm:text-[13px] text-neutral-500 dark:text-neutral-400 leading-tight">
                {item.issuer}
              </p>
            )}
            <p class="text-xs sm:text-[13px] text-neutral-500 dark:text-neutral-400 leading-tight">
              {formattedDate}
            </p>
          </div>
        </a>
      );
    })}
  </div>
</section>
