---
---

<section class="mb-40">
  <div class="mb-8">
    <span class="text-primary font-bold tracking-widest text-xs uppercase block mb-1">
      Contributions
    </span>
    <h2 class="text-4xl font-bold text-on-surface tracking-tighter">
      Github
    </h2>
  </div>
  <div class="border border-outline-variant/10 rounded-2xl bg-surface-container-lowest p-6 md:p-8 overflow-hidden shadow-sm">
    <div class="overflow-x-auto">
      <div class="min-w-[800px] w-full">
        <img
          src="https://ghchart.rshah.org/788fec/stdrouuu"
          alt="stdrouuu's GitHub Contributions Calendar"
          class="w-full h-auto select-none"
        />
      </div>
    </div>
    <div class="flex flex-col sm:flex-row justify-between items-center mt-6 text-xs text-slate-400 gap-4">
      <p>
        View full profile and activity directly on
        <a href="https://github.com/stdrouuu" target="_blank" rel="noopener noreferrer" class="text-primary font-bold hover:underline">
          GitHub
        </a>.
      </p>
      <div class="flex items-center gap-1.5 select-none">
        <span>Less</span>
        <span class="w-3 h-3 rounded-sm bg-slate-100"></span>
        <span class="w-3 h-3 rounded-sm bg-[#c3d4ff]"></span>
        <span class="w-3 h-3 rounded-sm bg-[#9cb7ff]"></span>
        <span class="w-3 h-3 rounded-sm bg-[#788fec]"></span>
        <span class="w-3 h-3 rounded-sm bg-[#4a63ce]"></span>
        <span>More</span>
      </div>
    </div>
  </div>
</section>
