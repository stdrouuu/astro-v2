---
import { alignContributionsToDate, generateSvg, fetchUserContributions } from '../../utils/githubContributions';

let initialSvg = '';

try {
  const contributions = await fetchUserContributions('stdrouuu');
  if (contributions.length) {
    const aligned = alignContributionsToDate(contributions);
    initialSvg = generateSvg(aligned);
  }
} catch (e) {
  console.error('Failed to fetch GitHub contributions at build time:', e);
}
---

<section class="space-y-3">
  <!-- Contribution SVG Grids -->
  <div class="py-1">
    <div class="w-full github-svg-wrapper relative overflow-x-auto overflow-y-hidden pb-2.5 sm:pb-0">
      <div id="github-chart-container" class="w-full">
        {initialSvg ? (
          <Fragment set:html={initialSvg} />
        ) : (
          <p class="text-[13px] text-neutral-500 font-mono py-8 text-center">Loading contributions…</p>
        )}
      </div>
    </div>
  </div>

  <!-- Floating GitHub Style Hover Tooltip -->
  <div
    id="github-tooltip"
    class="pointer-events-none fixed z-[9999] hidden -translate-x-1/2 -translate-y-full px-2 py-0.5 text-[12px] font-sans font-normal text-white bg-[#1b1f23] dark:bg-[#24292f] border border-neutral-700/80 rounded-md shadow-lg whitespace-nowrap"
    style="top: 0; left: 0;"
  >
    <span id="github-tooltip-text"></span>
    <div id="github-tooltip-caret" class="absolute left-1/2 -bottom-1 -translate-x-1/2 w-2 h-2 rotate-45 bg-[#1b1f23] dark:bg-[#24292f] border-r border-b border-neutral-700/80"></div>
  </div>

  <!-- Bottom Legend and Link -->
  <div class="flex flex-row justify-between items-center text-[13px] sm:text-[14px] font-sans text-neutral-500 gap-2 pt-0.5 select-none">
    <p class="truncate text-neutral-500 dark:text-neutral-400 flex items-center gap-1">
      <span class="hidden sm:inline">View my full contribution on </span>
      <a
        href="https://github.com/stdrouuu"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 text-neutral-900 dark:text-neutral-100 border-b border-neutral-400 dark:border-neutral-400 font-normal hover:text-black dark:hover:text-white hover:border-black dark:hover:border-white transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="shrink-0 -mt-px">
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
        </svg>
        GitHub ↗
      </a>
    </p>
    <div class="flex items-center gap-1 sm:gap-1.5 text-[11px] sm:text-xs text-neutral-500 shrink-0">
      <span>Less</span>
      <span class="w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-sm bg-[#EEEEEE] dark:bg-[#222222]"></span>
      <span class="w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-sm bg-[#c3d4ff] dark:bg-[#223566]"></span>
      <span class="w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-sm bg-[#9cb7ff] dark:bg-[#395399]"></span>
      <span class="w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-sm bg-[#788fec] dark:bg-[#5b73cc]"></span>
      <span class="w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-sm bg-[#4a63ce] dark:bg-[#788fec]"></span>
      <span>More</span>
    </div>
  </div>
</section>

<script>
  import { alignContributionsToDate, generateSvg, fetchUserContributions, type ContributionDay } from '../../utils/githubContributions';

  function formatTooltipDate(dateStr: string) {
    const [, m, d] = dateStr.split('-').map(Number);
    const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    const monthName = months[m - 1];

    let suffix = 'th';
    if (d % 10 === 1 && d !== 11) suffix = 'st';
    else if (d % 10 === 2 && d !== 12) suffix = 'nd';
    else if (d % 10 === 3 && d !== 13) suffix = 'rd';

    return `${monthName} ${d}${suffix}`;
  }

  function setupGithubInteractive() {
    const tooltip = document.getElementById('github-tooltip');
    const tooltipText = document.getElementById('github-tooltip-text');
    const tooltipCaret = document.getElementById('github-tooltip-caret');
    const wrapper = document.querySelector<HTMLElement>('.github-svg-wrapper');

    if (!wrapper || !tooltip || !tooltipText) return;

    // Prevent duplicate event listener attachments
    if ((wrapper as any)._githubInteractiveInitialized) return;
    (wrapper as any)._githubInteractiveInitialized = true;

    // Tooltip handling
    wrapper.addEventListener('mouseover', (e) => {
      const target = (e.target as HTMLElement)?.closest('rect');
      if (!target) return;

      const count = target.getAttribute('data-count');
      const date = target.getAttribute('data-date');
      if (!date || count === null) return;

      const cNum = Number(count);
      const countText = cNum === 0 ? 'No contributions' : cNum === 1 ? '1 contribution' : `${cNum} contributions`;
      const formattedDate = formatTooltipDate(date);

      tooltipText.textContent = `${countText} on ${formattedDate}.`;

      // Measure tooltip width after setting text
      tooltip.classList.remove('hidden');
      const tooltipWidth = tooltip.offsetWidth;
      const halfWidth = tooltipWidth / 2;

      const rectBounds = target.getBoundingClientRect();
      const targetCenterX = rectBounds.left + rectBounds.width / 2;
      const targetTop = rectBounds.top - 8;

      // Clamp tooltip within viewport boundaries so it is never cropped
      const screenPadding = 8;
      const minCenterX = halfWidth + screenPadding;
      const maxCenterX = window.innerWidth - halfWidth - screenPadding;
      const clampedCenterX = Math.max(minCenterX, Math.min(maxCenterX, targetCenterX));

      tooltip.style.left = `${clampedCenterX}px`;
      tooltip.style.top = `${targetTop}px`;

      // Align caret arrow with the target cell
      if (tooltipCaret) {
        const caretOffset = targetCenterX - clampedCenterX;
        tooltipCaret.style.left = `calc(50% + ${caretOffset}px)`;
      }
    });

    wrapper.addEventListener('mouseout', (e) => {
      const target = (e.target as HTMLElement)?.closest('rect');
      if (target) {
        tooltip.classList.add('hidden');
      }
    });

    window.addEventListener('scroll', () => {
      tooltip.classList.add('hidden');
    }, { passive: true });
  }

  async function loadGithubContributions() {
    const container = document.getElementById('github-chart-container');
    if (!container) return;

    const now = new Date();
    const year = now.getFullYear();
    const month = String(now.getMonth() + 1).padStart(2, '0');
    const day = String(now.getDate()).padStart(2, '0');
    const todayStr = `${year}-${month}-${day}`;

    const cacheKey = `gh_contrib_v3_${todayStr}`;

    // Inspect the rendered grid to see what date it currently ends on
    const cells = container.querySelectorAll<SVGRectElement>('rect.github-cell');
    const lastCell = cells[cells.length - 1];
    const lastRenderedDate = lastCell?.getAttribute('data-date');

    // 1. Check if we already have today's data cached in sessionStorage
    const cachedData = sessionStorage.getItem(cacheKey);
    if (cachedData) {
      try {
        const parsed = JSON.parse(cachedData) as ContributionDay[];
        if (lastRenderedDate !== todayStr) {
          const aligned = alignContributionsToDate(parsed, now);
          const svg = generateSvg(aligned);
          if (svg) container.innerHTML = svg;
        }
        return;
      } catch {
        sessionStorage.removeItem(cacheKey);
      }
    }

    // 2. Fetch fresh contributions (including private contributions) from API
    try {
      const contributions = await fetchUserContributions('stdrouuu');
      if (!contributions.length) return;

      try {
        sessionStorage.setItem(cacheKey, JSON.stringify(contributions));
      } catch {}

      const aligned = alignContributionsToDate(contributions, now);
      const svg = generateSvg(aligned);
      if (svg) {
        container.innerHTML = svg;
      }
    } catch (err) {
      console.warn('Failed to load GitHub contributions for system date:', err);
    }
  }

  function scrollChartToEnd() {
    const wrapper = document.querySelector<HTMLElement>('.github-svg-wrapper');
    if (wrapper) {
      wrapper.scrollLeft = wrapper.scrollWidth;
    }
  }

  function init() {
    setupGithubInteractive();
    loadGithubContributions().then(() => {
      scrollChartToEnd();
    });
    scrollChartToEnd();
  }

  // Run on page load and support view transitions
  init();
  document.addEventListener('astro:page-load', init);
</script>

<style is:global>
  /* Style the inlined SVG elements */
  .github-svg-wrapper {
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: #94a3b8 #e2e8f0;
  }
  .github-svg-wrapper::-webkit-scrollbar {
    height: 6px;
    -webkit-appearance: none;
    appearance: none;
  }
  .github-svg-wrapper::-webkit-scrollbar-track {
    background: #f1f5f9;
    border-radius: 9999px;
  }
  .github-svg-wrapper::-webkit-scrollbar-thumb {
    background-color: #94a3b8;
    border-radius: 9999px;
  }
  .dark .github-svg-wrapper {
    scrollbar-color: #475569 #1e293b;
  }
  .dark .github-svg-wrapper::-webkit-scrollbar-track {
    background: #1e293b;
  }
  .dark .github-svg-wrapper::-webkit-scrollbar-thumb {
    background-color: #475569;
  }
  @media (min-width: 640px) {
    .github-svg-wrapper {
      scrollbar-width: none;
    }
    .github-svg-wrapper::-webkit-scrollbar {
      display: none;
    }
  }
  .github-svg-wrapper svg {
    width: 100% !important;
    min-width: 660px !important;
    height: auto !important;
    background: transparent !important;
  }
  @media (min-width: 640px) {
    .github-svg-wrapper svg {
      min-width: 100% !important;
    }
  }
  
  /* Month names and day labels in the SVG */
  .github-svg-wrapper svg text {
    fill: #73736e !important; /* Neutral-500 */
    font-family: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
    font-size: 9px !important;
  }

  /* Base rect styling */
  .github-svg-wrapper svg rect {
    shape-rendering: geometricPrecision;
    rx: 2px;
    cursor: pointer;
    transition: stroke 0.1s ease;
  }

  .github-svg-wrapper svg rect:hover {
    stroke: rgba(0, 0, 0, 0.45);
    stroke-width: 1px;
  }

  /* Empty cell color (light mode) */
  .github-svg-wrapper svg rect[data-score="0"],
  .github-svg-wrapper svg rect:not([data-score]) {
    fill: #EEEEEE !important;
  }

  /* Contribution levels (light mode) */
  .github-svg-wrapper svg rect[data-score="1"] { fill: #c3d4ff !important; }
  .github-svg-wrapper svg rect[data-score="2"] { fill: #9cb7ff !important; }
  .github-svg-wrapper svg rect[data-score="3"] { fill: #788fec !important; }
  .github-svg-wrapper svg rect[data-score="4"] { fill: #4a63ce !important; }

  /* Dark mode overrides */
  .dark .github-svg-wrapper svg text {
    fill: #a3a39f !important;
  }

  .dark .github-svg-wrapper svg rect:hover {
    stroke: rgba(255, 255, 255, 0.5);
    stroke-width: 1px;
  }

  /* Empty cell color (dark mode) */
  .dark .github-svg-wrapper svg rect[data-score="0"],
  .dark .github-svg-wrapper svg rect:not([data-score]) {
    fill: #222222 !important;
  }

  /* Contribution levels (dark mode) */
  .dark .github-svg-wrapper svg rect[data-score="1"] { fill: #223566 !important; }
  .dark .github-svg-wrapper svg rect[data-score="2"] { fill: #395399 !important; }
  .dark .github-svg-wrapper svg rect[data-score="3"] { fill: #5b73cc !important; }
  .dark .github-svg-wrapper svg rect[data-score="4"] { fill: #788fec !important; }
</style>
