---
// Fetch the GitHub contribution SVG at build time to inline it
let svgContent = '';
try {
  const response = await fetch('https://ghchart.rshah.org/788fec/stdrouuu');
  if (response.ok) {
    svgContent = await response.text();
    // Remove any hardcoded style blocks from the API SVG to avoid overriding our custom CSS
    svgContent = svgContent.replace(/<style>[\s\S]*?<\/style>/, '');
  }
} catch (e) {
  console.error('Failed to fetch GitHub chart:', e);
}
---

<section class="space-y-4">
  <div class="bg-transparent space-y-4">
    <div class="overflow-x-auto overflow-y-hidden py-1 custom-scrollbar">
      <div class="min-w-[700px] w-full github-svg-wrapper">
        {svgContent ? (
          <Fragment set:html={svgContent} />
        ) : (
          <p class="text-xs text-neutral-500 font-mono">Loading contributions...</p>
        )}
      </div>
    </div>
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center text-xs font-mono text-neutral-500 gap-4">
      <p>
        View full profile on{' '}
        <a href="https://github.com/stdrouuu" target="_blank" rel="noopener noreferrer" class="text-neutral-800 dark:text-neutral-200 underline underline-offset-4 hover:text-black dark:hover:text-white">
          GitHub ↗
        </a>
      </p>
      <div class="flex items-center gap-1.5 select-none text-[11px]">
        <span>Less</span>
        <span class="w-2.5 h-2.5 rounded-sm bg-[#EEEEEE] dark:bg-[#222222]"></span>
        <span class="w-2.5 h-2.5 rounded-sm bg-[#c3d4ff] dark:bg-[#223566]"></span>
        <span class="w-2.5 h-2.5 rounded-sm bg-[#9cb7ff] dark:bg-[#395399]"></span>
        <span class="w-2.5 h-2.5 rounded-sm bg-[#788fec] dark:bg-[#5b73cc]"></span>
        <span class="w-2.5 h-2.5 rounded-sm bg-[#4a63ce] dark:bg-[#788fec]"></span>
        <span>More</span>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* Style the inlined SVG elements */
  .github-svg-wrapper svg {
    width: 100% !important;
    height: auto !important;
    background: transparent !important;
  }
  
  /* Month names and day labels in the SVG */
  .github-svg-wrapper svg text {
    fill: #73736e !important; /* Neutral-500 */
    font-family: 'Geist Mono', 'ui-monospace', monospace !important;
    font-size: 9px !important;
  }

  /* Base rect styling */
  .github-svg-wrapper svg rect {
    shape-rendering: geometricPrecision;
    rx: 2px;
  }

  /* Empty cell color (light mode) */
  .github-svg-wrapper svg rect[data-score="0"],
  .github-svg-wrapper svg rect:not([data-score]) {
    fill: #EEEEEE !important;
  }

  /* Contribution levels (light mode) */
  .github-svg-wrapper svg rect[data-score="1"] { fill: #c3d4ff !important; }
  .github-svg-wrapper svg rect[data-score="2"] { fill: #9cb7ff !important; }
  .github-svg-wrapper svg rect[data-score="3"] { fill: #788fec !important; }
  .github-svg-wrapper svg rect[data-score="4"] { fill: #4a63ce !important; }

  /* Dark mode overrides */
  .dark .github-svg-wrapper svg text {
    fill: #a3a39f !important;
  }

  /* Empty cell color (dark mode) */
  .dark .github-svg-wrapper svg rect[data-score="0"],
  .dark .github-svg-wrapper svg rect:not([data-score]) {
    fill: #222222 !important;
  }

  /* Contribution levels (dark mode) */
  .dark .github-svg-wrapper svg rect[data-score="1"] { fill: #223566 !important; }
  .dark .github-svg-wrapper svg rect[data-score="2"] { fill: #395399 !important; }
  .dark .github-svg-wrapper svg rect[data-score="3"] { fill: #5b73cc !important; }
  .dark .github-svg-wrapper svg rect[data-score="4"] { fill: #788fec !important; }
</style>
