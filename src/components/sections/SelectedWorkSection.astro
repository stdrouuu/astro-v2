---
import ProjectMedia from '../ProjectMedia.astro';
import { featuredProject as project } from '../../data/projects';
---

<section id="work" class="space-y-5" aria-labelledby="featured-title">
  <h2 id="featured-title" class="readme-heading"><span aria-hidden="true">##</span> Selected Work</h2>
  <article class="space-y-4">
    <ProjectMedia project={project} />
    <div class="space-y-2.5 border-l-2 border-neutral-300 dark:border-neutral-700 pl-3 sm:pl-4">
      <h3 class="font-medium text-xl">{project.title}</h3>
      <p class="text-neutral-700 dark:text-neutral-300 text-base">{project.summary} I led planning and contributed Blade templates and Tailwind styling.</p>
      <div class="flex flex-wrap gap-x-5">
        <a href={`/projects/${project.slug}`} class="quiet-link">Read case study <span aria-hidden="true">↗</span></a>
        <a href={project.code} target="_blank" rel="noopener noreferrer" class="quiet-link">Source code <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </article>
</section>
