---

<section class="space-y-4 sm:space-y-6 pt-2 sm:pt-4">
  <h2 class="font-pixel text-xl sm:text-2xl md:text-3xl flex items-center gap-2 border-y border-neutral-300/80 dark:border-neutral-800 py-3 sm:py-4 my-4 sm:my-6">
    <span class="text-neutral-400">##</span>
    <span>Current Stack</span>
  </h2>

  <div class="flex flex-col gap-4 sm:gap-5">
    {techCategories.map((group) => (
      <div class="space-y-2">
        <div class="flex items-center gap-2">
          <span class="text-[13px] sm:text-sm font-medium text-neutral-600 dark:text-neutral-300">
            {group.category}
          </span>
          <div class="flex-1 h-px bg-neutral-200/80 dark:bg-neutral-800/80"></div>
        </div>

        <div class="flex flex-wrap items-center justify-start gap-1.5 sm:gap-2">
          {group.items.map((tech) => (
            <div class="inline-flex items-center gap-2 px-2.5 sm:px-3 py-1.5 rounded-md bg-neutral-200/50 dark:bg-neutral-800/60 hover:bg-neutral-200 dark:hover:bg-neutral-800 border border-neutral-300/60 dark:border-neutral-700/50 hover:border-neutral-400 dark:hover:border-neutral-600 transition-all duration-200 select-none group cursor-default max-w-full">
              <div class={`${tech.wrapperClass || 'w-5 h-5 sm:w-5 sm:h-5'} flex-shrink-0 flex items-center justify-center rounded-md`}>
                <img
                  src={tech.icon}
                  alt={tech.name}
                  class={`w-full h-full ${tech.imgClass || 'object-contain'} rounded-md group-hover:scale-110 transition-transform duration-200 ${tech.darkInvert ? 'dark:invert dark:brightness-200' : ''}`}
                  loading="lazy"
                />
              </div>
              <div class="flex flex-col justify-center min-w-0">
                <span class="text-[13px] sm:text-[13.5px] font-medium text-neutral-800 dark:text-neutral-200 group-hover:text-neutral-950 dark:group-hover:text-white transition-colors leading-tight truncate">
                  {tech.name}
                </span>
                <span class="text-[11px] sm:text-[11.5px] text-neutral-500 dark:text-neutral-400 leading-tight truncate">
                  {tech.sub}
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>






