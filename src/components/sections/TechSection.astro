---
const techs = [
  { name: 'Laravel',    sub: 'PHP Web Framework',     icon: 'laravel/laravel-original' },
  { name: 'Python',     sub: 'Scripting & AI',        icon: 'python/python-original' },
  { name: 'TypeScript', sub: 'JavaScript but better', icon: 'typescript/typescript-original' },
  { name: 'Vue.js',     sub: 'Frontend Framework',    icon: 'vuejs/vuejs-original' },
  { name: 'PHP',        sub: 'Backend Language',      icon: 'php/php-original' },
  { name: 'MySQL',      sub: 'Relational Database',   icon: 'mysql/mysql-original' },
  { name: 'PostgreSQL', sub: 'Advanced Database',     icon: 'postgresql/postgresql-original' },
  { name: 'Git',        sub: 'Version Control',       icon: 'git/git-original' },
];
---

<section class="space-y-8 pt-4">
  <h2 class="font-pixel text-2xl md:text-3xl flex items-center gap-2 border-y border-neutral-300/80 py-4 my-6">
    <span class="text-neutral-400">##</span>
    <span>Current Stack</span>
  </h2>

  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
    {techs.map((tech) => (
      <div class="flex items-center gap-4 p-4 bg-white dark:bg-neutral-900 border border-neutral-300/80 dark:border-neutral-800 rounded-2xl shadow-sm hover:shadow-md hover:border-primary/50 transition-all group duration-300">
        <div class="w-12 h-12 rounded-full bg-neutral-100 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform duration-300">
          <img
            src={`https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/${tech.icon}.svg`}
            alt={tech.name}
            class="w-6 h-6"
          />
        </div>
        <div>
          <h4 class="text-sm font-bold text-neutral-900 dark:text-neutral-200">{tech.name}</h4>
          <p class="text-xs text-neutral-500 dark:text-neutral-500 mt-0.5">{tech.sub}</p>
        </div>
      </div>
    ))}
  </div>
</section>
