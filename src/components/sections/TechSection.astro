---

<section id="tech" class="space-y-4 sm:space-y-6 pt-2 sm:pt-4">
  <h2 class="font-pixel text-3xl sm:text-3xl md:text-4xl flex items-center gap-2 border-y border-neutral-300/80 dark:border-neutral-800 py-3 sm:py-4 my-4 sm:my-6">
    <span class="text-neutral-400">##</span>
    <span>Current Stack</span>
  </h2>

  <div class="flex flex-col gap-4 sm:gap-5">
    {techCategories.map((group) => (
      <div class="space-y-2">
        <div class="flex items-center gap-2">
          <span class="text-sm sm:text-sm font-medium text-neutral-600 dark:text-neutral-300">
            {group.category}
          </span>
          <div class="flex-1 h-px bg-neutral-200/80 dark:bg-neutral-800/80"></div>
        </div>

        <div class="grid grid-cols-1 sm:flex sm:flex-wrap sm:items-center sm:justify-start gap-1.5 sm:gap-2">
          {group.items.map((tech) => (
            <div class="relative overflow-hidden flex sm:inline-flex items-center gap-2.5 px-3 py-2 rounded-md bg-neutral-200/50 dark:bg-neutral-800/60 hover:bg-neutral-200 dark:hover:bg-neutral-800 border border-neutral-300/60 dark:border-neutral-700/50 hover:border-neutral-400 dark:hover:border-neutral-600 transition-all duration-200 select-none group cursor-default w-full sm:w-auto">
              <div class={`${tech.wrapperClass || 'w-8 h-8 sm:w-8 sm:h-8'} flex-shrink-0 flex items-center justify-center relative z-10`}>
                <img
                  src={tech.icon}
                  alt={tech.name}
                  class={`w-full h-full ${tech.imgClass || 'object-contain'} group-hover:scale-110 transition-transform duration-200 ${tech.darkInvert ? 'dark:invert dark:brightness-200' : ''}`}
                  loading="lazy"
                />
              </div>
              <div class="flex flex-col justify-center min-w-0 relative z-10">
                <span class="text-[15px] font-medium text-neutral-800 dark:text-neutral-200 group-hover:text-neutral-950 dark:group-hover:text-white transition-colors leading-tight truncate sm:whitespace-nowrap">
                  {tech.name}
                </span>
                <span class="text-[14px] text-neutral-500 dark:text-neutral-400 leading-tight truncate sm:whitespace-nowrap">
                  {tech.sub}
                </span>
              </div>

              <!-- Overlay Watermark Icon (Mobile only) -->
              <div class="absolute -right-4 -bottom-4 sm:hidden w-20 h-20 pointer-events-none opacity-10 dark:opacity-15 rotate-12 group-hover:opacity-25 dark:group-hover:opacity-30 group-hover:scale-110 group-hover:rotate-6 transition-all duration-300">
                <img
                  src={tech.icon}
                  alt=""
                  class={`w-full h-full ${tech.imgClass || 'object-contain'} ${tech.darkInvert ? 'dark:invert' : ''}`}
                  loading="lazy"
                />
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>






