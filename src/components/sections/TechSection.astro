---
const devicon = 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons';

const stackGroups = [
  {
    name: 'AI & Machine Learning',
    items: [
      { name: 'PyTorch', description: 'Deep Learning', icon: `${devicon}/pytorch/pytorch-original.svg` },
      { name: 'TorchVision', description: 'Computer Vision', icon: `${devicon}/pytorch/pytorch-original.svg` },
      { name: 'Python', description: 'AI & Scripts', icon: `${devicon}/python/python-original.svg` },
      { name: 'TensorFlow', description: 'ML Framework', icon: `${devicon}/tensorflow/tensorflow-original.svg` },
    ],
  },
  {
    name: 'Backend',
    items: [
      { name: 'FastAPI', description: 'Python Web Framework', icon: '/img/fastapi.svg' },
      { name: 'Laravel', description: 'PHP Web Framework', icon: '/img/laravel.webp' },
      { name: 'PostgreSQL', description: 'Advanced SQL', icon: `${devicon}/postgresql/postgresql-original.svg` },
      { name: 'MySQL', description: 'Relational Database', icon: `${devicon}/mysql/mysql-original.svg` },
      { name: 'Supabase', description: 'Backend & Postgres', icon: `${devicon}/supabase/supabase-original.svg` },
      { name: 'Prisma', description: 'ORM', icon: '/img/prisma.webp' },
    ],
  },
  {
    name: 'Web App',
    items: [
      { name: 'Next.js', description: 'React Framework', icon: `${devicon}/nextjs/nextjs-original.svg` },
      { name: 'React', description: 'UI Library', icon: `${devicon}/react/react-original.svg` },
      { name: 'Astro.js', description: 'Content-driven Web', icon: '/img/astro.webp' },
      { name: 'Tailwind CSS', description: 'CSS Framework', icon: `${devicon}/tailwindcss/tailwindcss-original.svg` },
      { name: 'Shadcn/ui', description: 'UI Components', icon: '/img/shadcn.webp' },
      { name: 'Framer Motion', description: 'Motion Library', icon: '/img/motion.webp' },
      { name: 'PWA', description: 'Progressive Web App', icon: '/img/pwa.webp' },
    ],
  },
  {
    name: 'Mobile Development',
    items: [
      { name: 'Kotlin', description: 'Android Development', icon: `${devicon}/kotlin/kotlin-original.svg` },
      { name: 'Android SDK', description: 'Native Android APIs', icon: `${devicon}/android/android-original.svg` },
      { name: 'Jetpack Compose', description: 'Android UI Toolkit', icon: `${devicon}/jetpackcompose/jetpackcompose-original.svg` },
      { name: 'Gradle', description: 'Build Automation', icon: `${devicon}/gradle/gradle-original.svg`, darkInvert: true },
    ],
  },
  {
    name: 'Languages & Tools',
    items: [
      { name: 'TypeScript', description: 'JavaScript Typed', icon: `${devicon}/typescript/typescript-original.svg` },
      { name: 'PHP', description: 'Used in Laravel', icon: `${devicon}/php/php-original.svg` },
      { name: 'Java', description: 'OOP Language', icon: `${devicon}/java/java-original.svg` },
      { name: 'Git', description: 'Version Control', icon: `${devicon}/git/git-original.svg` },
      { name: 'GitHub Actions', description: 'CI / CD Pipelines', icon: `${devicon}/githubactions/githubactions-original.svg` },
      { name: 'Docker', description: 'Containerization', icon: '/img/docker.webp' },
      { name: 'Cloudflare Tunnels & CDN', description: 'Network Infrastructure', icon: `${devicon}/cloudflare/cloudflare-original.svg` },
      { name: 'Postman', description: 'API Testing & Dev', icon: `${devicon}/postman/postman-original.svg` },
      { name: 'Orca', description: 'Agentic Workspace', icon: '/img/orca.webp' },
    ],
  },
];
---

<section id="tech" class="space-y-4 sm:space-y-6 pt-2 sm:pt-4">
  <h2 class="font-pixel text-3xl md:text-4xl flex items-center gap-2 border-y border-neutral-300/80 dark:border-neutral-800 py-3 sm:py-4 my-4 sm:my-6">
    <span class="text-neutral-400">##</span>
    <span>Current Stack</span>
  </h2>

  <div class="space-y-5">
    {stackGroups.map(({ name, items }) => (
      <section class="flex flex-col gap-2">
        <h3 class="flex items-center gap-2 text-sm font-medium text-neutral-600 dark:text-neutral-300">
          {name}
          <span aria-hidden="true" class="h-px flex-1 bg-neutral-200/80 dark:bg-neutral-800"></span>
        </h3>
        <ul role="list" class="flex flex-wrap gap-2">
          {items.map((item) => (
            <li class="stack-pill inline-flex max-w-full items-center gap-1.5 rounded-md border border-neutral-300/80 bg-neutral-200/50 px-2.5 py-1 text-xs font-medium leading-4 text-neutral-800 dark:border-neutral-700 dark:text-neutral-200">
              <img src={item.icon} alt="" width="22" height="22" loading="lazy" decoding="async" class:list={['h-[22px] w-[22px] shrink-0 rounded-sm object-contain', item.darkInvert && 'dark:brightness-0 dark:invert']} />
              <span class="flex min-w-0 flex-col leading-none">
                <span>{item.name}</span>
                <span class="stack-description truncate text-[11px] font-normal leading-none" title={item.description}>{item.description}</span>
              </span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</section>

<style>
  :global(.dark) .stack-pill {
    background-color: #252525;
  }

  .stack-description {
    margin-top: -2px;
    color: #73736e;
  }
</style>
