---
---

<section class="mb-40" id="experience">
  <div class="mb-8">
    <span class="text-primary font-bold tracking-widest text-xs uppercase mb-1 block">
      Education &amp; Experience
    </span>
    <h2 class="text-4xl font-bold text-on-surface tracking-tighter">
      Experience
    </h2>
  </div>

  <!-- Tab Selector -->
  <div class="flex p-1 bg-slate-100 rounded-xl w-full mb-8 border border-outline-variant/10">
    <button
      id="tab-work"
      class="flex-1 py-2.5 text-sm font-bold rounded-lg text-slate-800 bg-white shadow-sm transition-all"
      data-tab="work"
    >
      Work
    </button>
    <button
      id="tab-journey"
      class="flex-1 py-2.5 text-sm font-semibold rounded-lg text-slate-500 hover:text-slate-800 transition-all"
      data-tab="journey"
    >
      Experience
    </button>
    <button
      id="tab-education"
      class="flex-1 py-2.5 text-sm font-semibold rounded-lg text-slate-500 hover:text-slate-800 transition-all"
      data-tab="education"
    >
      Education
    </button>
  </div>

  <!-- Timeline Box -->
  <div class="bg-white border border-outline-variant/10 rounded-2xl p-6 md:p-10 relative">
    <!-- Timeline vertical line -->
    <div class="absolute left-[48px] md:left-[72px] top-12 md:top-18 bottom-12 md:bottom-18 w-px bg-slate-200"></div>

    <!-- Tab Content: Work -->
    <div id="content-work" class="space-y-12 relative">

      <!-- Item: Freelance Software Engineer -->
      <div class="flex gap-6 md:gap-8 relative group">
        <div class="w-12 h-12 md:w-16 md:h-16 rounded-full bg-white border border-slate-200 shadow-sm flex items-center justify-center overflow-hidden z-10 flex-shrink-0">
          <i class="ri-briefcase-line text-xl md:text-2xl text-primary"></i>
        </div>
        <div class="flex-1 min-w-0">
          <h3 class="text-xl font-bold text-slate-900 tracking-tight">Freelance Software Engineer</h3>
          <div class="mt-2">
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-1">
              <p class="text-sm font-semibold text-slate-500">Software Developer / Architect</p>
              <span class="text-xs font-semibold text-slate-400 sm:text-right">2024 - Present</span>
            </div>
            <ul class="list-disc list-outside text-slate-600 text-sm mt-2 ml-4 space-y-1.5 leading-relaxed">
              <li>Developed custom web platforms (Laravel, Vue.js, Inertia.js) for clients like SDK 10 Penabur and ASN exam simulation groups.</li>
              <li>Configured database structures, API routes, and clean admin dashboards with responsive layouts.</li>
              <li>Built timer mechanisms, custom PDF generators, and audio player integrations for client requirements.</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Item: Campus Intern -->
      <div class="flex gap-6 md:gap-8 relative group">
        <div class="w-12 h-12 md:w-16 md:h-16 rounded-full bg-white border border-slate-200 shadow-sm flex items-center justify-center overflow-hidden z-10 flex-shrink-0">
          <i class="ri-school-line text-xl md:text-2xl text-primary"></i>
        </div>
        <div class="flex-1 min-w-0">
          <h3 class="text-xl font-bold text-slate-900 tracking-tight">MiSchool Platform</h3>
          <div class="mt-2">
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-1">
              <p class="text-sm font-semibold text-slate-500">Software Developer (Intern)</p>
              <span class="text-xs font-semibold text-slate-400 sm:text-right">Feb 2024 - Jul 2024</span>
            </div>
            <ul class="list-disc list-outside text-slate-600 text-sm mt-2 ml-4 space-y-1.5 leading-relaxed">
              <li>Assisted in building comprehensive school portals for attendance checking and curriculum tracking.</li>
              <li>Collaborated on building parent portals and teacher evaluation modules in Laravel &amp; Vue.</li>
            </ul>
          </div>
        </div>
      </div>

    </div>

    <!-- Tab Content: My Journey -->
    <div id="content-journey" class="space-y-12 relative hidden">

      <!-- Item: Campus Project -->
      <div class="flex gap-6 md:gap-8 relative group">
        <div class="w-12 h-12 md:w-16 md:h-16 rounded-full bg-white border border-slate-200 shadow-sm flex items-center justify-center overflow-hidden z-10 flex-shrink-0">
          <i class="ri-code-s-slash-line text-xl md:text-2xl text-primary"></i>
        </div>
        <div class="flex-1 min-w-0">
          <h3 class="text-xl font-bold text-slate-900 tracking-tight">Library Archive Analytics</h3>
          <div class="mt-2">
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-1">
              <p class="text-sm font-semibold text-slate-500">UKRIDA Campus Project</p>
              <span class="text-xs font-semibold text-slate-400 sm:text-right">2024</span>
            </div>
            <ul class="list-disc list-outside text-slate-600 text-sm mt-2 ml-4 space-y-1.5 leading-relaxed">
              <li>Designed and built a database search system processing over 50,000 research articles.</li>
              <li>Implemented full-text search with sub-second response times using PostgreSQL indexing.</li>
            </ul>
            <div class="mt-4 flex flex-wrap gap-2">
              <a
                href="#"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-primary hover:bg-primary/90 text-white text-xs font-bold rounded-lg transition-colors shadow-sm select-none cursor-pointer"
              >
                <i class="ri-global-line text-[12px]"></i>
                Library Archive
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Item: Matriculation -->
      <div class="flex gap-6 md:gap-8 relative group">
        <div class="w-12 h-12 md:w-16 md:h-16 rounded-full bg-white border border-slate-200 shadow-sm flex items-center justify-center overflow-hidden z-10 flex-shrink-0">
          <img
            src="https://upload.wikimedia.org/wikipedia/commons/0/07/Logo_Ukrida.png"
            alt="UKRIDA"
            class="w-10 h-10 object-contain"
            onerror="this.src='/img/logo.png'"
          />
        </div>
        <div class="flex-1 min-w-0">
          <h3 class="text-xl font-bold text-slate-900 tracking-tight">Universitas Kristen Krida Wacana</h3>
          <div class="mt-2">
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-1">
              <p class="text-sm font-semibold text-slate-500">University Matriculation</p>
              <span class="text-xs font-semibold text-slate-400 sm:text-right">Aug 2022</span>
            </div>
            <ul class="list-disc list-outside text-slate-600 text-sm mt-2 ml-4 space-y-1.5 leading-relaxed">
              <li>Admitted under Academic Scholarship.</li>
              <li>Began Bachelor of Computer Science degree.</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Item: Hackathon Award -->
      <div class="flex gap-6 md:gap-8 relative group">
        <div class="w-12 h-12 md:w-16 md:h-16 rounded-full bg-white border border-slate-200 shadow-sm flex items-center justify-center overflow-hidden z-10 flex-shrink-0">
          <i class="ri-award-line text-xl md:text-2xl text-primary"></i>
        </div>
        <div class="flex-1 min-w-0">
          <h3 class="text-xl font-bold text-slate-900 tracking-tight">Hackathon Award</h3>
          <div class="mt-2">
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-1">
              <p class="text-sm font-semibold text-slate-500">Top 10 School Hackathon &apos;23</p>
              <span class="text-xs font-semibold text-slate-400 sm:text-right">Oct 2023</span>
            </div>
            <ul class="list-disc list-outside text-slate-600 text-sm mt-2 ml-4 space-y-1.5 leading-relaxed">
              <li>Placed in the Top 10 nationally for creating a school accessibility web application for students with special educational needs.</li>
              <li>Focused on text-to-speech rendering and keyboard-only navigation pathways.</li>
            </ul>
          </div>
        </div>
      </div>

    </div>

    <!-- Tab Content: Education -->
    <div id="content-education" class="space-y-12 relative hidden">

      <!-- Item: UKRIDA -->
      <div class="flex gap-6 md:gap-8 relative group">
        <div class="w-12 h-12 md:w-16 md:h-16 rounded-full bg-white border border-slate-200 shadow-sm flex items-center justify-center overflow-hidden z-10 flex-shrink-0">
          <img
            src="https://upload.wikimedia.org/wikipedia/commons/0/07/Logo_Ukrida.png"
            alt="UKRIDA"
            class="w-10 h-10 object-contain"
            onerror="this.src='/img/logo.png'"
          />
        </div>
        <div class="flex-1 min-w-0">
          <h3 class="text-xl font-bold text-slate-900 tracking-tight">Universitas Kristen Krida Wacana</h3>
          <div class="mt-2">
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-1">
              <p class="text-sm font-semibold text-slate-500">Bachelor of Computer Science</p>
              <span class="text-xs font-semibold text-slate-400 sm:text-right">2022 - 2026 (Expected)</span>
            </div>
            <ul class="list-disc list-outside text-slate-600 text-sm mt-2 ml-4 space-y-1.5 leading-relaxed">
              <li>Current GPA: 3.8 / 4.0</li>
              <li>Recipient of the Academic Scholarship.</li>
              <li>Focusing on Backend Architectures, Software Design, and Distributed Databases.</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Item: SMAK 6 Penabur -->
      <div class="flex gap-6 md:gap-8 relative group">
        <div class="w-12 h-12 md:w-16 md:h-16 rounded-full bg-white border border-slate-200 shadow-sm flex items-center justify-center overflow-hidden z-10 flex-shrink-0">
          <img
            src="https://upload.wikimedia.org/wikipedia/id/3/3a/Logo_BPK_PENABUR.png"
            alt="SMAK 6 Penabur"
            class="w-10 h-10 object-contain"
            onerror="this.src='/img/logo.png'"
          />
        </div>
        <div class="flex-1 min-w-0">
          <h3 class="text-xl font-bold text-slate-900 tracking-tight">SMAK 6 BPK Penabur</h3>
          <div class="mt-2">
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-1">
              <p class="text-sm font-semibold text-slate-500">Natural Sciences (IPA)</p>
              <span class="text-xs font-semibold text-slate-400 sm:text-right">2019 - 2022</span>
            </div>
            <ul class="list-disc list-outside text-slate-600 text-sm mt-2 ml-4 space-y-1.5 leading-relaxed">
              <li>Graduated with honors.</li>
              <li>Active in school programming clubs and digital design projects.</li>
            </ul>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  // Timeline Tab Switcher
  const tabWork = document.getElementById('tab-work');
  const tabJourney = document.getElementById('tab-journey');
  const tabEducation = document.getElementById('tab-education');

  const contentWork = document.getElementById('content-work');
  const contentJourney = document.getElementById('content-journey');
  const contentEducation = document.getElementById('content-education');

  const tabs = [tabWork, tabJourney, tabEducation];
  const contents = [contentWork, contentJourney, contentEducation];

  tabs.forEach(tab => {
    tab?.addEventListener('click', () => {
      const targetTab = tab.getAttribute('data-tab');

      tabs.forEach(t => {
        if (t) {
          if (t.getAttribute('data-tab') === targetTab) {
            t.className = 'flex-1 py-2.5 text-sm font-bold rounded-lg text-slate-800 bg-white shadow-sm transition-all';
          } else {
            t.className = 'flex-1 py-2.5 text-sm font-semibold rounded-lg text-slate-500 hover:text-slate-800 transition-all';
          }
        }
      });

      contents.forEach(c => {
        if (c) {
          if (c.id === `content-${targetTab}`) {
            c.classList.remove('hidden');
          } else {
            c.classList.add('hidden');
          }
        }
      });
    });
  });
</script>
