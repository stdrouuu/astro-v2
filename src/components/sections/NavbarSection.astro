---
interface Props {
  page: 'home' | 'projects' | 'case-study';
}
const { page } = Astro.props;
const home = page === 'home' ? '' : '/';
const links = [
  { label: 'Home', href: `${home}#content` },
  { label: 'Work', href: `${home}#work-education` },
  { label: 'Competitions', href: `${home}#recognition` },
  { label: 'Projects', href: `${home}#projects`, current: page === 'projects' },
  { label: 'Stack', href: `${home}#tech` },
  { label: 'Certs', href: `${home}#certifications` },
  { label: 'Contact', href: '#contact' },
];
---

<header class="mb-10 sm:mb-16">
  <nav aria-label="Main navigation" class="flex items-center justify-between gap-2 sm:gap-4 font-pixel text-xs text-neutral-500 dark:text-neutral-400 border-b border-neutral-300/80 dark:border-neutral-800 pb-4">
    <a href={`${home}#content`} class="min-w-0 truncate text-[15px] sm:text-xs font-pixel text-neutral-500 dark:text-neutral-400 hover:text-black dark:hover:text-white transition-colors">
      ~/README.md
    </a>

    <!-- Desktop Navigation -->
    <div class="hidden sm:flex items-center gap-4 shrink-0 text-xs font-pixel">
      {links.map(({ label, href, current }) => (
        <a href={href} aria-current={current ? 'page' : undefined} class="hover:text-black dark:hover:text-white transition-colors whitespace-nowrap">{label}</a>
      ))}
      <button type="button" id="theme-toggle" aria-label="Dark mode" aria-pressed="false" class="nav-control text-neutral-500 dark:text-neutral-400 hover:text-black dark:hover:text-white transition-colors ml-1 w-4 h-4 flex items-center justify-center relative shrink-0">
        <!-- Sun icon (shown in dark mode) -->
        <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" class="hidden w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
    </div>

    <!-- Mobile Header Actions (Theme Toggle + Hamburger) -->
    <div class="flex sm:hidden items-center gap-1 shrink-0">
      <button type="button" id="theme-toggle-mobile" aria-label="Dark mode" aria-pressed="false" class="nav-control text-neutral-500 dark:text-neutral-400 hover:text-black dark:hover:text-white transition-colors w-8 h-8 flex items-center justify-center relative">
        <!-- Sun icon mobile -->
        <svg id="icon-sun-mobile" xmlns="http://www.w3.org/2000/svg" class="hidden w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <!-- Moon icon mobile -->
        <svg id="icon-moon-mobile" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <button
        id="mobile-menu-toggle"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="nav-control text-neutral-500 dark:text-neutral-400 hover:text-black dark:hover:text-white transition-colors w-8 h-8 flex items-center justify-center relative"
      >
        <!-- Menu Icon -->
        <svg id="icon-menu" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        <!-- Close (X) Icon -->
        <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden sm:hidden flex-col font-pixel text-[15px] border-b border-neutral-300/80 dark:border-neutral-800 py-2.5">
    <div class="grid grid-cols-2 gap-1.5 text-neutral-600 dark:text-neutral-400">
      {links.map(({ label, href, current }) => (
        <a href={href} aria-current={current ? 'page' : undefined} class="mobile-nav-link flex items-center gap-1.5 px-2.5 py-2 max-[380px]:px-1.5 max-[380px]:text-xs rounded-md hover:bg-neutral-100 dark:hover:bg-neutral-900 hover:text-black dark:hover:text-white transition-colors">
          <span class="text-neutral-400 dark:text-neutral-600">##</span> {label}
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const themeButtons = [
    {
      button: document.getElementById('theme-toggle'),
      sun: document.getElementById('icon-sun'),
      moon: document.getElementById('icon-moon'),
    },
    {
      button: document.getElementById('theme-toggle-mobile'),
      sun: document.getElementById('icon-sun-mobile'),
      moon: document.getElementById('icon-moon-mobile'),
    },
  ];

  function setTheme(isDark: boolean) {
    root.classList.toggle('dark', isDark);
    document.getElementById('theme-color-meta')?.setAttribute('content', isDark ? '#181818' : '#F7F5F0');
    for (const { button, sun, moon } of themeButtons) {
      button?.setAttribute('aria-pressed', String(isDark));
      sun?.classList.toggle('hidden', !isDark);
      moon?.classList.toggle('hidden', isDark);
    }
  }

  setTheme(root.classList.contains('dark'));
  for (const { button } of themeButtons) {
    button?.addEventListener('click', () => {
      const isDark = !root.classList.contains('dark');
      setTheme(isDark);
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch {
        // Keep the choice for this page when storage is unavailable.
      }
    });
  }

  const menuButton = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  function setMenu(isOpen: boolean) {
    mobileMenu?.classList.toggle('hidden', !isOpen);
    iconMenu?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
    menuButton?.setAttribute('aria-expanded', String(isOpen));
  }

  menuButton?.addEventListener('click', () => setMenu(menuButton.getAttribute('aria-expanded') !== 'true'));
  mobileMenu?.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a')) setMenu(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      menuButton.focus();
    }
  });
</script>
