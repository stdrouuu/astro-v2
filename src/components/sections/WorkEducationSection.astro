---
interface ExperienceItem {
  period: string;
  role: string;
  organization: string;
  logo: string;
  logoClass?: string;
  url?: string;
  description: string;
}

const workItems: ExperienceItem[] = [
  {
    period: '2026 — Present',
    role: 'Fullstack Developer',
    organization: 'GPdI Duta Bandara Permai',
    logo: '/img/gpdi.webp',
    description:
    'Developed and maintained internal management systems, web applications, and congregation service platforms to streamline church administration and operations.',
  },
  {
    period: '2026 — Present',
    role: 'Freelance Developer',
    organization: 'Self-Employed',
    logo: '/img/logo-hover.png',
    logoClass: 'rounded-md overflow-hidden',
    description:
      'Building custom web applications, responsive modern user interfaces, and fullstack digital solutions for clients and independent projects.',
  },
];

const educationItems: ExperienceItem[] = [
  {
    period: '2024 — Present',
    role: 'BSc Computer Science',
    organization: 'UKRIDA',
    logo: '/img/ukrida.webp',
    url: 'https://ukrida.ac.id',
    description:
      'Undergraduate majoring in Computer Science with a focus on Software Engineering, Web Development, Algorithms, and Human-Centred Computing.',
  },
  {
    period: '2021 — 2024',
    role: 'Natural Sciences (MIPA)',
    organization: 'SMAK 6 PENABUR Jakarta',
    logo: '/img/penabur.webp',
    description:
      'Senior High School education with focus on science and mathematics, actively exploring computer programming and software development.',
  },
  {
    period: '2018 — 2021',
    role: 'Junior High School',
    organization: 'SMPK 6 PENABUR Jakarta',
    logo: '/img/penabur.webp',
    description:
      'Completed junior high school education with strong academic foundations in science.',
  },
];
---

<section id="work-education" class="space-y-4 sm:space-y-6 pt-2 sm:pt-4">
  <div>
    <h2 class="font-pixel text-3xl sm:text-3xl md:text-4xl flex items-center gap-2 border-y border-neutral-300/80 dark:border-neutral-800 py-3 sm:py-4 my-4 sm:my-6">
      <span class="text-neutral-400">##</span>
      <span>Work & Education</span>
    </h2>
    <p class="text-neutral-600 dark:text-neutral-400 text-sm sm:text-sm leading-relaxed">
      Organizations I&apos;ve worked with and academic institutions that shaped my foundation.
    </p>
  </div>

  <!-- Tab Switcher -->
  <div class="flex items-center gap-2 font-sans text-sm border-b border-neutral-200/80 dark:border-neutral-800 pb-2">
    <button
      id="tab-btn-work"
      class="tab-btn px-3 py-1 rounded-md text-neutral-900 dark:text-white bg-neutral-200/70 dark:bg-neutral-800 font-medium transition-all"
      data-target="work-tab-content"
    >
      Work
    </button>
    <button
      id="tab-btn-education"
      class="tab-btn px-3 py-1 rounded-md text-neutral-500 hover:text-neutral-900 dark:hover:text-white transition-all"
      data-target="education-tab-content"
    >
      Education
    </button>
  </div>

  <!-- Tab Content 1: Work -->
  <div id="work-tab-content" class="tab-panel divide-y divide-neutral-200/70 dark:divide-neutral-800/80 pt-1">
    {
      workItems.map((item, index) => (
        <details class="group py-3.5 sm:py-4" open={index === 0}>
          <summary class="list-none flex items-center justify-between gap-3.5 sm:gap-4 cursor-pointer select-none">
            <div class="flex items-center gap-3.5 sm:gap-4 flex-1 min-w-0">
              <!-- Big Logo -->
              <div class={`w-10 h-10 sm:w-12 sm:h-12 flex-shrink-0 flex items-center justify-center group-hover:scale-105 transition-transform ${item.logoClass || ''}`}>
                <img
                  src={item.logo}
                  alt={item.organization}
                  class={`w-full h-full object-contain ${item.logoClass || ''}`}
                />
              </div>

              <!-- Year & Title -->
              <div class="flex-1 min-w-0 flex flex-col justify-center gap-0.5 sm:gap-1">
                <span class="text-sm sm:text-sm text-neutral-600 dark:text-neutral-300 font-medium">
                  {item.period}
                </span>
                <h3 class="text-neutral-900 dark:text-white font-medium text-[17px] sm:text-[16px] leading-snug flex items-center flex-wrap gap-x-1.5">
                  <span>{item.role}</span>
                  <span class="text-neutral-500 dark:text-neutral-400 font-normal">at</span>
                  <span class="text-neutral-900 dark:text-white font-medium">{item.organization}</span>
                </h3>
              </div>
            </div>

            <!-- Chevron Indicator -->
            <div class="flex-shrink-0 text-neutral-500 dark:text-neutral-300 group-hover:text-neutral-900 dark:group-hover:text-white transition-colors ml-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 h-4 transition-transform duration-200 group-open:rotate-180"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </div>
          </summary>

          <!-- Accordion Body -->
          <div class="pl-[54px] sm:pl-[64px] pt-2 text-neutral-600 dark:text-neutral-400 text-[15px] leading-relaxed">
            <p>{item.description}</p>
          </div>
        </details>
      ))
    }
  </div>

  <!-- Tab Content 2: Education -->
  <div id="education-tab-content" class="tab-panel hidden divide-y divide-neutral-200/70 dark:divide-neutral-800/80 pt-1">
    {
      educationItems.map((item, index) => (
        <details class="group py-3.5 sm:py-4" open={index === 0}>
          <summary class="list-none flex items-center justify-between gap-3.5 sm:gap-4 cursor-pointer select-none">
            <div class="flex items-center gap-3.5 sm:gap-4 flex-1 min-w-0">
              <!-- Big Logo -->
              <div class={`w-10 h-10 sm:w-12 sm:h-12 flex-shrink-0 flex items-center justify-center group-hover:scale-105 transition-transform ${item.logoClass || ''}`}>
                <img
                  src={item.logo}
                  alt={item.organization}
                  class={`w-full h-full object-contain ${item.logoClass || ''}`}
                />
              </div>

              <!-- Year & Title -->
              <div class="flex-1 min-w-0 flex flex-col justify-center gap-0.5 sm:gap-1">
                <span class="text-sm sm:text-sm text-neutral-600 dark:text-neutral-300 font-medium">
                  {item.period}
                </span>
                <h3 class="text-neutral-900 dark:text-white font-medium text-[17px] sm:text-[16px] leading-snug">
                  <span class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-1.5">
                    <span>{item.role}</span>
                    <span class="flex items-center gap-x-1.5">
                      <span class="text-neutral-500 dark:text-neutral-400 font-normal">at</span>
                      {item.url ? (
                        <a
                          href={item.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-neutral-900 dark:text-white font-medium hover:underline inline-flex items-center gap-1"
                          onclick="event.stopPropagation()"
                        >
                          {item.organization}
                        </a>
                      ) : (
                        <span class="text-neutral-900 dark:text-white font-medium">{item.organization}</span>
                      )}
                    </span>
                  </span>
                </h3>
              </div>
            </div>

            <!-- Chevron Indicator -->
            <div class="flex-shrink-0 text-neutral-500 dark:text-neutral-300 group-hover:text-neutral-900 dark:group-hover:text-white transition-colors ml-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 h-4 transition-transform duration-200 group-open:rotate-180"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </div>
          </summary>

          <!-- Accordion Body -->
          <div class="pl-[54px] sm:pl-[64px] pt-2 text-neutral-600 dark:text-neutral-400 text-[15px] leading-relaxed">
            <p>{item.description}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<script>
  function setupWorkEducationTabs() {
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabPanels = document.querySelectorAll('.tab-panel');

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');

        // Reset all buttons
        tabBtns.forEach((b) => {
          b.classList.remove('text-neutral-900', 'dark:text-white', 'bg-neutral-200/70', 'dark:bg-neutral-800', 'font-medium');
          b.classList.add('text-neutral-500');
        });

        // Activate clicked button
        btn.classList.add('text-neutral-900', 'dark:text-white', 'bg-neutral-200/70', 'dark:bg-neutral-800', 'font-medium');
        btn.classList.remove('text-neutral-500');

        // Toggle panel visibility
        tabPanels.forEach((panel) => {
          if (panel.id === targetId) {
            panel.classList.remove('hidden');
          } else {
            panel.classList.add('hidden');
          }
        });
      });
    });
  }

  // Run on initial load and navigation
  setupWorkEducationTabs();
  document.addEventListener('astro:page-load', setupWorkEducationTabs);
</script>
