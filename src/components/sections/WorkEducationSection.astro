<section id="work-education" class="space-y-4 sm:space-y-6 pt-2 sm:pt-4">
  <div>
    <h2 class="font-pixel text-xl sm:text-2xl md:text-3xl flex items-center gap-2 border-y border-neutral-300/80 dark:border-neutral-800 py-3 sm:py-4 my-4 sm:my-6">
      <span class="text-neutral-400">##</span>
      <span>Work & Education</span>
    </h2>
    <p class="text-neutral-600 dark:text-neutral-400 text-xs sm:text-sm leading-relaxed">
      Organizations I&apos;ve worked with and academic institutions that shaped my foundation.
    </p>
  </div>

  <!-- Tab Switcher -->
  <div class="flex items-center gap-2 font-mono text-xs border-b border-neutral-200/80 dark:border-neutral-800 pb-2">
    <button
      id="tab-btn-work"
      class="tab-btn px-3 py-1 rounded-md text-neutral-900 dark:text-white bg-neutral-200/70 dark:bg-neutral-800 font-medium transition-all"
      data-target="work-tab-content"
    >
      Work
    </button>
    <button
      id="tab-btn-education"
      class="tab-btn px-3 py-1 rounded-md text-neutral-500 hover:text-neutral-900 dark:hover:text-white transition-all"
      data-target="education-tab-content"
    >
      Education
    </button>
  </div>

  <!-- Tab Content 1: Work -->
  <div id="work-tab-content" class="tab-panel divide-y divide-neutral-200/80 dark:divide-neutral-800">
    
    <!-- Item: GPdI Duta Bandara -->
    <div class="flex items-center justify-between py-3 group">
      <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
        <div class="w-9 h-9 sm:w-10 sm:h-10 flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform duration-300">
          <img
            src="/img/gpdi.webp"
            alt="GPdI Duta Bandara Permai"
            class="w-full h-full object-contain"
          />
        </div>
        <div class="min-w-0 flex flex-col justify-center">
          <h3 class="font-medium text-neutral-900 dark:text-neutral-100 text-[15px] leading-snug truncate">
            GPdI Duta Bandara Permai 
          </h3>
          <p class="text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 leading-tight">
            Fullstack Developer
          </p>
        </div>
      </div>
      <span class="font-mono text-xs text-neutral-500 dark:text-neutral-400 flex-shrink-0 ml-4">
        Jun 2026 - Present
      </span>
    </div>

  </div>

  <!-- Tab Content 2: Education -->
  <div id="education-tab-content" class="tab-panel hidden divide-y divide-neutral-200/80 dark:divide-neutral-800">
    
    <!-- Item 1: UKRIDA -->
    <div class="flex items-center justify-between py-3 group">
      <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
        <div class="w-9 h-9 sm:w-10 sm:h-10 flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform duration-300">
          <img
            src="/img/ukrida.webp"
            alt="UKRIDA"
            class="w-full h-full object-contain"
          />
        </div>
        <div class="min-w-0 flex flex-col justify-center">
          <a
            href="https://ukrida.ac.id"
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-neutral-900 dark:text-neutral-100 text-[15px] leading-snug hover:text-black dark:hover:text-white inline-flex items-center gap-1 group/link"
          >
            <span>UKRIDA</span>
            <span class="font-mono text-[11px] text-neutral-400 group-hover/link:text-neutral-700 dark:group-hover/link:text-neutral-300">↗</span>
          </a>
          <p class="text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 leading-tight">
            Undergraduate Computer Science Major
          </p>
        </div>
      </div>
      <span class="font-mono text-xs text-neutral-500 dark:text-neutral-400 flex-shrink-0 ml-4">
        2024 — Now
      </span>
    </div>

    <!-- Item 2: SMAK 6 BPK PENABUR Jakarta -->
    <div class="flex items-center justify-between py-3 group">
      <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
        <div class="w-9 h-9 sm:w-10 sm:h-10 flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform duration-300">
          <img
            src="/img/penabur.webp"
            alt="SMAK 6 BPK PENABUR Jakarta"
            class="w-full h-full object-contain"
          />
        </div>
        <div class="min-w-0 flex flex-col justify-center">
          <h3 class="font-medium text-neutral-900 dark:text-neutral-100 text-[15px] leading-snug truncate">
            SMAK 6 BPK PENABUR Jakarta
          </h3>
          <p class="text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 leading-tight">
            Senior High School
          </p>
        </div>
      </div>
      <span class="font-mono text-xs text-neutral-500 dark:text-neutral-400 flex-shrink-0 ml-4">
        2021 — 2024
      </span>
    </div>

    <!-- Item 3: SMPK 6 BPK PENABUR Jakarta -->
    <div class="flex items-center justify-between py-3 group">
      <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
        <div class="w-9 h-9 sm:w-10 sm:h-10 flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform duration-300">
          <img
            src="/img/penabur.webp"
            alt="SMPK 6 BPK PENABUR Jakarta"
            class="w-full h-full object-contain"
          />
        </div>
        <div class="min-w-0 flex flex-col justify-center">
          <h3 class="font-medium text-neutral-900 dark:text-neutral-100 text-[15px] leading-snug truncate">
            SMPK 6 BPK PENABUR Jakarta
          </h3>
          <p class="text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 leading-tight">
            Junior High School
          </p>
        </div>
      </div>
      <span class="font-mono text-xs text-neutral-500 dark:text-neutral-400 flex-shrink-0 ml-4">
        2018 — 2021
      </span>
    </div>

    <!-- Item 4: SDK 10 BPK PENABUR Jakarta -->
    <div class="flex items-center justify-between py-3 group">
      <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
        <div class="w-9 h-9 sm:w-10 sm:h-10 flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform duration-300">
          <img
            src="/img/penabur.webp"
            alt="SDK 10 BPK PENABUR Jakarta"
            class="w-full h-full object-contain"
          />
        </div>
        <div class="min-w-0 flex flex-col justify-center">
          <h3 class="font-medium text-neutral-900 dark:text-neutral-100 text-[15px] leading-snug truncate">
            SDK 10 BPK PENABUR Jakarta
          </h3>
          <p class="text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 leading-tight">
            Elementary School
          </p>
        </div>
      </div>
      <span class="font-mono text-xs text-neutral-500 dark:text-neutral-400 flex-shrink-0 ml-4">
        2012 — 2018
      </span>
    </div>

  </div>
</section>

<script>
  function setupWorkEducationTabs() {
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabPanels = document.querySelectorAll('.tab-panel');

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');

        // Reset all buttons
        tabBtns.forEach((b) => {
          b.classList.remove('text-neutral-900', 'dark:text-white', 'bg-neutral-200/70', 'dark:bg-neutral-800', 'font-medium');
          b.classList.add('text-neutral-500');
        });

        // Activate clicked button
        btn.classList.add('text-neutral-900', 'dark:text-white', 'bg-neutral-200/70', 'dark:bg-neutral-800', 'font-medium');
        btn.classList.remove('text-neutral-500');

        // Toggle panel visibility
        tabPanels.forEach((panel) => {
          if (panel.id === targetId) {
            panel.classList.remove('hidden');
          } else {
            panel.classList.add('hidden');
          }
        });
      });
    });
  }

  // Run on initial load and navigation
  setupWorkEducationTabs();
  document.addEventListener('astro:page-load', setupWorkEducationTabs);
</script>

