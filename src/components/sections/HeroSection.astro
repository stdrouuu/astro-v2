    <div class="lg:col-span-4 bg-surface-container-low rounded-xl overflow-hidden relative group">
      <img
        alt="Brandon Jeremiah Sutedja"
        class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700"
        src="/img/face.webp"
      />
      <div class="absolute bottom-6 left-6 right-6 p-6 bg-white/60 backdrop-blur-xl rounded-lg">
        <p class="text-sm font-bold text-on-surface">
          Brandon Jeremiah Sutedja
        </p>
        <p class="text-xs text-on-surface-variant uppercase tracking-widest mt-1">
          Software Engineer · Jakarta
        </p>
      </div>
    </div>
  </div>

  {/* Academic & Stats Bento */}
  <div class="grid grid-cols-1 md:grid-cols-4 lg:grid-cols-6 gap-6" id="stats">
    <div class="md:col-span-2 lg:col-span-2 bg-surface-container p-8 rounded-3xl flex flex-col h-full min-h-[240px]">
      <i class="ri-graduation-cap-line text-primary text-4xl mb-4"></i>
      <div class="mt-auto">
        <h3 class="text-2xl font-bold mb-2">UKRIDA</h3>
        <p class="text-on-surface-variant text-sm leading-relaxed">
          Bachelor of Computer Science
          <br />
          Expected Graduation 2026
        </p>
      </div>
    </div>
    <div class="md:col-span-2 lg:col-span-2 bg-primary text-on-primary p-8 rounded-3xl flex flex-col h-full min-h-[240px]">
      <div>
        <h3 class="text-5xl font-extrabold mb-1">3.8</h3>
        <p class="text-on-primary/80 text-xs font-bold uppercase tracking-widest">
          Cumulative GPA
        </p>
      </div>
      <div class="mt-auto pt-6 border-t border-white/20">
        <p class="text-sm leading-relaxed text-on-primary/90">
          &quot;I study modern technologies and build functional, real-world applications.&quot;
        </p>
      </div>
    </div>
    <div class="md:col-span-4 lg:col-span-2 bg-surface-container-high p-8 rounded-3xl flex flex-col h-full min-h-[240px] justify-center">
      <h3 class="text-xl font-bold mb-4">Core Stack</h3>
      <div class="flex flex-wrap gap-2.5">
        <div class="flex items-center gap-2 px-3 py-1.5 bg-surface-container-lowest rounded-full shadow-sm">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/python/python-original.svg" alt="Python" class="w-4 h-4" />
          <span class="text-slate-800 text-xs font-bold uppercase">Python</span>
        </div>
        <div class="flex items-center gap-2 px-3 py-1.5 bg-surface-container-lowest rounded-full shadow-sm">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/react/react-original.svg" alt="React" class="w-4 h-4" />
          <span class="text-slate-800 text-xs font-bold uppercase">React</span>
        </div>
        <div class="flex items-center gap-2 px-3 py-1.5 bg-surface-container-lowest rounded-full shadow-sm">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/typescript/typescript-original.svg" alt="TypeScript" class="w-4 h-4" />
          <span class="text-slate-800 text-xs font-bold uppercase">TypeScript</span>
        </div>
        <div class="flex items-center gap-2 px-3 py-1.5 bg-surface-container-lowest rounded-full shadow-sm">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/postgresql/postgresql-original.svg" alt="Postgres" class="w-4 h-4" />
          <span class="text-slate-800 text-xs font-bold uppercase">Postgres</span>
        </div>
        <div class="flex items-center gap-2 px-3 py-1.5 bg-surface-container-lowest rounded-full shadow-sm">
          <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/docker/docker-original.svg" alt="Docker" class="w-4 h-4" />
          <span class="text-slate-800 text-xs font-bold uppercase">Docker</span>
        </div>
      </div>
    </div>
  </div>
</section>
