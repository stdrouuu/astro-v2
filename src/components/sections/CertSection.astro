---
---

<section class="mb-40">
  <div class="mb-8">
    <span class="text-primary font-bold tracking-widest text-xs block mb-1">
      Paper of
    </span>
    <h2 class="text-4xl font-bold text-on-surface tracking-tighter">
      Certifications
    </h2>
  </div>
  <div class="border border-outline-variant/10 rounded-2xl bg-surface-container-lowest overflow-hidden">
    <div class="relative">
      <!-- Timeline dashed line -->
      <div class="absolute left-16 top-8 bottom-8 w-px border-l border-dashed border-outline-variant/30 hidden md:block"></div>

      <div class="divide-y divide-outline-variant/10">

        <!-- Item 1: Dicoding -->
        <div class="flex items-center gap-6 p-6 md:p-8 hover:bg-primary transition-all duration-300 relative group cursor-pointer">
          <div class="w-16 h-16 rounded-full bg-white border border-outline-variant/10 shadow-sm flex items-center justify-center overflow-hidden z-10 flex-shrink-0">
            <img
              src="https://media.licdn.com/dms/image/v2/C560BAQF2fN6yG5j3jQ/company-logo_200_200/company-logo_200_200/0/1630656094593/dicoding_logo?e=2147483647&v=beta&t=H-Kq6XN4q9vL6f9YQ3q9zZ-4Z5a3q9Z5a3q9zZ5a3q9"
              alt="Dicoding"
              class="w-10 h-10 object-contain"
              onerror="this.src='/img/logo.png'"
            />
          </div>
          <div class="flex-1 min-w-0">
            <h4 class="text-lg font-bold text-slate-800 tracking-tight truncate group-hover:text-white transition-colors">
              Menjadi Back-End Developer Expert
            </h4>
            <p class="text-sm text-slate-400 mt-1 group-hover:text-white/80 transition-colors">
              @ Dicoding Indonesia <span class="mx-2 text-slate-300 group-hover:text-white/40 transition-colors">|</span> 15.08.2025
            </p>
          </div>
          <a
            href="https://www.dicoding.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full hover:bg-slate-100/10 group-hover:hover:bg-white/20 flex items-center justify-center text-slate-400 group-hover:text-white transition-all flex-shrink-0"
          >
            <i class="ri-arrow-right-up-line text-xl transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"></i>
          </a>
        </div>

        <!-- Item 2: Google -->
        <div class="flex items-center gap-6 p-6 md:p-8 hover:bg-primary transition-all duration-300 relative group cursor-pointer">
          <div class="w-16 h-16 rounded-full bg-white border border-outline-variant/10 shadow-sm flex items-center justify-center overflow-hidden z-10 flex-shrink-0">
            <img
              src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/google/google-original.svg"
              alt="Google"
              class="w-8 h-8 object-contain"
            />
          </div>
          <div class="flex-1 min-w-0">
            <h4 class="text-lg font-bold text-slate-800 tracking-tight truncate group-hover:text-white transition-colors">
              Google Cloud Certified - Associate Cloud Engineer
            </h4>
            <p class="text-sm text-slate-400 mt-1 group-hover:text-white/80 transition-colors">
              @ Google <span class="mx-2 text-slate-300 group-hover:text-white/40 transition-colors">|</span> 10.05.2025
            </p>
          </div>
          <a
            href="https://cloud.google.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full hover:bg-slate-100/10 group-hover:hover:bg-white/20 flex items-center justify-center text-slate-400 group-hover:text-white transition-all flex-shrink-0"
          >
            <i class="ri-arrow-right-up-line text-xl transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"></i>
          </a>
        </div>

        <!-- Item 3: Oracle -->
        <div class="flex items-center gap-6 p-6 md:p-8 hover:bg-primary transition-all duration-300 relative group cursor-pointer">
          <div class="w-16 h-16 rounded-full bg-white border border-outline-variant/10 shadow-sm flex items-center justify-center overflow-hidden z-10 flex-shrink-0">
            <img
              src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/oracle/oracle-original.svg"
              alt="Oracle"
              class="w-10 h-10 object-contain"
            />
          </div>
          <div class="flex-1 min-w-0">
            <h4 class="text-lg font-bold text-slate-800 tracking-tight truncate group-hover:text-white transition-colors">
              Java SE 11 Developer Certified Professional
            </h4>
            <p class="text-sm text-slate-400 mt-1 group-hover:text-white/80 transition-colors">
              @ Oracle <span class="mx-2 text-slate-300 group-hover:text-white/40 transition-colors">|</span> 22.02.2025
            </p>
          </div>
          <a
            href="https://education.oracle.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full hover:bg-slate-100/10 group-hover:hover:bg-white/20 flex items-center justify-center text-slate-400 group-hover:text-white transition-all flex-shrink-0"
          >
            <i class="ri-arrow-right-up-line text-xl transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"></i>
          </a>
        </div>

        <!-- Item 4: Codepolitan -->
        <div class="flex items-center gap-6 p-6 md:p-8 hover:bg-primary transition-all duration-300 relative group cursor-pointer">
          <div class="w-16 h-16 rounded-full bg-white border border-outline-variant/10 shadow-sm flex items-center justify-center overflow-hidden z-10 flex-shrink-0">
            <img
              src="https://media.licdn.com/dms/image/v2/C4E0BAQE8O2Hylg0NJA/company-logo_200_200/company-logo_200_200/0/1630654060855/codepolitan_logo?e=2147483647&v=beta&t=j9X5a3q9zZ-4Z5a3q9Z5a3q9zZ5a3q9"
              alt="Codepolitan"
              class="w-10 h-10 object-contain"
              onerror="this.src='/img/logo.png'"
            />
          </div>
          <div class="flex-1 min-w-0">
            <h4 class="text-lg font-bold text-slate-800 tracking-tight truncate group-hover:text-white transition-colors">
              Fullstack PHP Laravel Web Developer
            </h4>
            <p class="text-sm text-slate-400 mt-1 group-hover:text-white/80 transition-colors">
              @ Codepolitan <span class="mx-2 text-slate-300 group-hover:text-white/40 transition-colors">|</span> 18.11.2024
            </p>
          </div>
          <a
            href="https://www.codepolitan.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full hover:bg-slate-100/10 group-hover:hover:bg-white/20 flex items-center justify-center text-slate-400 group-hover:text-white transition-all flex-shrink-0"
          >
            <i class="ri-arrow-right-up-line text-xl transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"></i>
          </a>
        </div>

        <!-- Item 5: freeCodeCamp (hidden by default) -->
        <div class="cert-extra hidden flex items-center gap-6 p-6 md:p-8 hover:bg-primary transition-all duration-300 relative group cursor-pointer">
          <div class="w-16 h-16 rounded-full bg-white border border-outline-variant/10 shadow-sm flex items-center justify-center overflow-hidden z-10 flex-shrink-0">
            <i class="ri-code-s-slash-line text-3xl text-slate-400 group-hover:text-slate-800 transition-colors"></i>
          </div>
          <div class="flex-1 min-w-0">
            <h4 class="text-lg font-bold text-slate-800 tracking-tight truncate group-hover:text-white transition-colors">
              Responsive Web Design Certification
            </h4>
            <p class="text-sm text-slate-400 mt-1 group-hover:text-white/80 transition-colors">
              @ freeCodeCamp <span class="mx-2 text-slate-300 group-hover:text-white/40 transition-colors">|</span> 05.08.2024
            </p>
          </div>
          <a
            href="https://freecodecamp.org"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full hover:bg-slate-100/10 group-hover:hover:bg-white/20 flex items-center justify-center text-slate-400 group-hover:text-white transition-all flex-shrink-0"
          >
            <i class="ri-arrow-right-up-line text-xl transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"></i>
          </a>
        </div>

      </div>
    </div>
  </div>

  <div class="flex justify-center mt-8">
    <button
      id="btn-show-more-certs"
      class="px-6 py-2.5 border border-outline-variant/30 text-on-surface-variant font-bold text-sm rounded-xl hover:bg-slate-50 transition-all duration-300 flex items-center gap-2 group shadow-sm bg-white"
    >
      + 1 More
    </button>
  </div>
</section>

<script>
  const btnShowMoreCerts = document.getElementById('btn-show-more-certs');
  const extraCerts = document.querySelectorAll('.cert-extra');
  let showingMoreCerts = false;

  btnShowMoreCerts?.addEventListener('click', () => {
    showingMoreCerts = !showingMoreCerts;
    extraCerts.forEach(cert => {
      if (showingMoreCerts) {
        cert.classList.remove('hidden');
      } else {
        cert.classList.add('hidden');
      }
    });
    if (btnShowMoreCerts) {
      btnShowMoreCerts.textContent = showingMoreCerts ? 'Show Less' : '+ 1 More';
    }
  });
</script>
