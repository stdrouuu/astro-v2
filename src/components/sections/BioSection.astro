---
import GithubSection from './GithubSection.astro';
---

<section id="content" class="space-y-5 sm:space-y-6">
  <!-- Profile Avatar & Name -->
  <div class="flex items-center gap-3.5 sm:gap-4">
    <div class="relative w-14 h-14 sm:w-16 sm:h-16 rounded-2xl overflow-hidden shadow-sm border border-neutral-200/80 dark:border-neutral-700/60 flex-shrink-0 group">
      <img
        src="/img/face.webp"
        alt="Brandon Jeremiah"
        class="w-full h-full object-cover scale-110 group-hover:scale-120 transition-transform duration-300 origin-center"
      />
      <span
        class="absolute bottom-1 right-1 w-3 h-3 sm:w-3.5 sm:h-3.5 bg-emerald-500 border-2 border-white dark:border-neutral-900 rounded-full"
        title="Available for work"
      ></span>
    </div>
    <div class="min-w-0">
      <div class="flex items-center gap-1.5 font-medium text-[18px] sm:text-lg text-neutral-900 dark:text-neutral-100">
        <span class="truncate">Brandon Jeremiah Sutedja</span>
        <!-- <svg class="w-4 h-4 text-[#6e93f0] fill-current inline-block flex-shrink-0" viewBox="0 0 24 24" aria-label="Verified">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1.2 14.2l-3.5-3.5 1.4-1.4 2.1 2.1 5.9-5.9 1.4 1.4-7.3 7.3z"/>
        </svg> -->
      </div>
      <p class="font-pixel text-[15px] sm:text-sm text-neutral-500 flex items-center gap-1 mt-0.5 leading-snug">
        <span>Software Engineer | U.G Computer Science @UKRIDA</span>
      </p>
    </div>
  </div>

  <p class="text-neutral-700 dark:text-neutral-300 text-[16.5px] sm:text-[17.5px] leading-relaxed">
    Hi, I&apos;m Brandon (19), a Software Engineer based in Jakarta, Indonesia.
    Frontend is my strongest discipline, but I work across product, backend architecture, and implementation to solve problems end to end.
  </p>

  <!-- Github Contributions -->
  <GithubSection />

  <!-- Profile Banner -->
  <div class="w-full h-28 sm:h-32 rounded-md overflow-hidden shadow-xs border border-neutral-200/80 dark:border-neutral-700/60 relative">
    <img
      src="/img/catbanner.gif"
      alt="Banner"
      class="w-full h-full object-cover object-bottom"
    />
  </div>

  <!-- Social Icons -->
  <div class="flex items-center gap-5 sm:gap-4 text-neutral-500 dark:text-neutral-400 pt-1">
    <a
      class="hover:text-black dark:hover:text-white transition-colors duration-200 p-1 -m-1"
      href="https://www.linkedin.com/in/brandon-jeremiah-sutedja/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="LinkedIn"
    >
      <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
      </svg>
