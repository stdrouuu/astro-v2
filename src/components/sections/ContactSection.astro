---
import SectionCat from '../SectionCat.astro';
---

<section id="contact" class="relative space-y-4 border-t border-neutral-300 dark:border-neutral-700 pt-8">
  <h2 class="font-pixel text-3xl sm:text-3xl md:text-4xl flex items-center gap-2">
    <span class="text-neutral-400">##</span>
    <span>Contact</span>
  </h2>
  <p class="text-neutral-700 dark:text-neutral-300 text-base">Have a problem that keeps coming back? Tell me about it.</p>
  <div class="flex gap-6 font-mono text-sm sm:text-sm pt-2">
    <a href="mailto:brandonjs.dev@gmail.com" class="text-neutral-800 dark:text-neutral-200 hover:text-black dark:hover:text-white underline underline-offset-4">email</a>
    <a href="https://www.linkedin.com/in/brandon-jeremiah-sutedja/" target="_blank" class="text-neutral-800 dark:text-neutral-200 hover:text-black dark:hover:text-white underline underline-offset-4">linkedin</a>
    <a href="https://github.com/stdrouuu" target="_blank" class="text-neutral-800 dark:text-neutral-200 hover:text-black dark:hover:text-white underline underline-offset-4">github</a>
  </div>
</section>

<footer class="relative mt-20 pt-6 border-t border-neutral-300 dark:border-neutral-700 flex flex-wrap justify-between items-center gap-x-3 gap-y-2 text-[15px] font-mono text-neutral-500">
  <SectionCat activity="calling" />
  <span>Last updated Nov 2026</span>
  <a href="#top" data-back-to-top class="hover:text-black dark:hover:text-white">Back to top ↑</a>
</footer>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelector<HTMLAnchorElement>('[data-back-to-top]')?.addEventListener('click', (event) => {
    if (reducedMotion.matches || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

    event.preventDefault();
    if (location.hash !== '#top') history.pushState(null, '', '#top');
    document.body.focus({ preventScroll: true });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
