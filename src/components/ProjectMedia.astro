---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  eager?: boolean;
}

const { project, eager = false } = Astro.props;
const { cover, tone } = project;
const maxWidth = Math.min(cover?.src.width ?? 0, eager ? 1600 : 1024);
const widths = [360, 640, 768, 1024, maxWidth].filter((width, index, candidates) =>
  width <= maxWidth && candidates.indexOf(width) === index
);
const sizes = eager
  ? '(min-width: 1168px) 68rem, (min-width: 1000px) calc(100vw - 5rem), (min-width: 400px) 92vw, calc(100vw - 2rem)'
  : '(min-width: 768px) 256px, (min-width: 672px) 272px, (min-width: 640px) calc((100vw - 8rem) / 2), calc(100vw - 4rem)';
---

<div class="project-media" data-tone={tone}>
  {cover ? (
    <Image
      src={cover.src}
      alt={cover.alt}
      class={`media-${project.slug}`}
      width={maxWidth}
      widths={widths}
      sizes={sizes}
      format="webp"
      priority={eager}
    />
  ) : (
    <div class="missing-image-avatar" role="img" aria-label="Project image not added yet">
      <span class="missing-image-sun" aria-hidden="true">☼</span>
      <span class="missing-image-card" aria-hidden="true"><span class="missing-image-face">•ᴗ•</span><span class="missing-image-corner">?</span></span>
      <span class="missing-image-sparkle" aria-hidden="true">✦</span>
    </div>
  )}
</div>
