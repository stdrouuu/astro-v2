---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, projectCategories } from '../data/projects';

const categories = ['All', ...projectCategories];
---

<PortfolioLayout
  page="projects"
  title="Projects | Brandon Jeremiah Sutedja"
  description="Explore client systems, independent web tools, and academic software projects by Brandon Jeremiah Sutedja."
>
  <div id="projects" class="space-y-5 sm:space-y-6">
    <header class="space-y-3">
      <a class="quiet-link" href="/"><span aria-hidden="true">←</span> Home</a>
      <h1 class="readme-heading"><span aria-hidden="true">##</span> Projects</h1>
      <p class="text-base text-neutral-700 dark:text-neutral-300">Client systems, independent web tools, and apps built with classmates.</p>
    </header>
    <div class="flex items-center justify-between flex-wrap gap-2 border-b border-neutral-300/80 dark:border-neutral-800 pb-2" data-filter-toolbar hidden>
      <div class="filters" role="group" aria-label="Filter projects">
        {categories.map((category) => (
          <button type="button" data-filter={category} aria-pressed={category === 'All'}>{category}</button>
        ))}
      </div>
      <p class="meta" data-project-count aria-live="polite">{projects.length} projects</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-7">
      {projects.map((project) => <ProjectCard project={project} heading="h2" />)}
    </div>
  </div>
</PortfolioLayout>

<script>
  const toolbar = document.querySelector<HTMLElement>('[data-filter-toolbar]');
  const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-project-category]')];
  const count = document.querySelector<HTMLElement>('[data-project-count]');

  function selectFilter(category: string) {
    for (const button of filters) {
      button.setAttribute('aria-pressed', String(button.dataset.filter === category));
    }

    let visible = 0;
    for (const card of cards) {
      card.hidden = category !== 'All' && card.dataset.projectCategory !== category;
      if (!card.hidden) visible++;
    }

    if (count) count.textContent = `${visible} ${visible === 1 ? 'project' : 'projects'}`;
  }

  if (toolbar) {
    toolbar.addEventListener('click', (event) => {
      if (!(event.target instanceof HTMLButtonElement)) return;
      selectFilter(event.target.dataset.filter ?? 'All');
    });
    toolbar.hidden = false;
  }
</script>
