---
import '../styles/global.css';
import NavbarSection from '../components/sections/NavbarSection.astro';
import BioSection from '../components/sections/BioSection.astro';

import TechSection from '../components/sections/TechSection.astro';
import WorkEducationSection from '../components/sections/WorkEducationSection.astro';
import SelectedWorkSection from '../components/sections/SelectedWorkSection.astro';
import PersonalProjectsSection from '../components/sections/PersonalProjectsSection.astro';
import CertificationsSection from '../components/sections/CertificationsSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Brandon Jeremiah — Software Engineer</title>
    <meta name="description" content="Brandon Jeremiah is a software engineer who builds tools and products that make repeated work easier and faster." />

    <!-- Open Graph / Facebook / WhatsApp / LinkedIn / Threads -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.brandonjeremiah.xyz/" />
    <meta property="og:site_name" content="Brandon Jeremiah" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content="Brandon Jeremiah — Software Engineer" />
    <meta property="og:description" content="Brandon Jeremiah is a software engineer who builds tools and products that make repeated work easier and faster." />
    <meta property="og:image" content="https://www.brandonjeremiah.xyz/img/personalsite.jpg" />
    <meta property="og:image:secure_url" content="https://www.brandonjeremiah.xyz/img/personalsite.jpg" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Brandon Jeremiah — Software Engineer" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://www.brandonjeremiah.xyz/" />
    <meta name="twitter:title" content="Brandon Jeremiah — Software Engineer" />
    <meta name="twitter:description" content="Brandon Jeremiah is a software engineer who builds tools and products that make repeated work easier and faster." />
    <meta name="twitter:image" content="https://www.brandonjeremiah.xyz/img/personalsite.jpg" />
    <meta name="twitter:image:alt" content="Brandon Jeremiah — Software Engineer" />

    <meta name="theme-color" id="theme-color-meta" content="#181818" />
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('theme');
        const isDark = saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (isDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
        const meta = document.getElementById('theme-color-meta') || document.querySelector('meta[name="theme-color"]');
        if (meta) {
          meta.setAttribute('content', isDark ? '#181818' : '#f7f5f0');
        }
      })();
    </script>
  </head>
  <body class="font-sans antialiased selection:bg-neutral-200 selection:text-neutral-900 min-h-screen text-[17px] sm:text-[17px] leading-relaxed">
    <div class="max-w-2xl mx-auto px-8 sm:px-12 md:px-16 py-6 sm:py-8">

      <NavbarSection />

      <main class="space-y-10 sm:space-y-16">
        <BioSection />
        <TechSection />
        <WorkEducationSection />
        <SelectedWorkSection />
        <PersonalProjectsSection />
        <CertificationsSection />
        <ContactSection />
      </main>

    </div>
  </body>
</html>

<script>
  import Lenis from 'lenis';

  const lenis = new Lenis({
    autoRaf: true,
  });
</script>
