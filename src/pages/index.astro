---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import BioSection from '../components/sections/BioSection.astro';
import TechSection from '../components/sections/TechSection.astro';
import WorkEducationSection from '../components/sections/WorkEducationSection.astro';
import PersonalProjectsSection from '../components/sections/PersonalProjectsSection.astro';
import CertificationsSection from '../components/sections/CertificationsSection.astro';
import RecognitionSection from '../components/sections/RecognitionSection.astro';

const description = 'Brandon Jeremiah Sutedja is a software engineer in Jakarta building full-stack applications, client systems, and everyday web tools.';
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Brandon Jeremiah Sutedja',
  alternateName: ['Brandon Jeremiah', 'Brandon Sutedja'],
  url: 'https://www.brandonjeremiah.xyz/',
  image: 'https://www.brandonjeremiah.xyz/img/face.webp',
  jobTitle: 'Software Engineer',
  address: { '@type': 'PostalAddress', addressLocality: 'Jakarta', addressCountry: 'ID' },
  affiliation: { '@type': 'EducationalOrganization', name: 'Universitas Kristen Krida Wacana', alternateName: 'UKRIDA' },
  sameAs: ['https://www.linkedin.com/in/brandon-jeremiah-sutedja/', 'https://github.com/stdrouuu', 'https://instagram.com/brandon._js'],
};
---

<PortfolioLayout title="Brandon Jeremiah Sutedja | Software Engineer" description={description}>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href="/img/catbanner-desktop.webp"
      type="image/webp"
      media="(width >= 640px) and (prefers-reduced-motion: no-preference)"
      fetchpriority="high"
    />
    <meta name="geo.region" content="ID-JK" />
    <meta name="geo.placename" content="Jakarta, Indonesia" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </Fragment>
  <BioSection />
  <WorkEducationSection />
  <RecognitionSection />
  <PersonalProjectsSection />
  <TechSection />
  <CertificationsSection />
</PortfolioLayout>

<script>
  const isTouch = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
  if (!isTouch && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    void import('lenis').then(({ default: Lenis }) => {
      new Lenis({ autoRaf: true });
    });
  }
</script>
